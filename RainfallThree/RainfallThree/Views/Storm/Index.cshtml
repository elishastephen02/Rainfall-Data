@model StormViewModel

<div class="container mt-4 px-3">
    <div class="card shadow-lg p-3 p-md-4 rounded-4 storm-search-card">
        <h2 class="text-center mb-4 storm-page-title">
            🌧 Storm Event Finder
        </h2>
        <form asp-action="Index" method="post" enctype="multipart/form-data">
            <div class="mb-3">
                <label class="form-label fw-bold">
                    Upload Rainfall CSV
                </label>
                <input type="file" asp-for="UploadedFile" class="form-control" />
                <span asp-validation-for="UploadedFile" class="text-danger"></span>
            </div>
            <div class="row">
                <div class="col-12 col-md-6 mb-3">
                    <label class="form-label fw-bold">
                        Rainfall Depth (mm)
                    </label>
                    <input asp-for="Depth" type="number" step="0.1" class="form-control" placeholder="e.g. 100" />
                    <span asp-validation-for="Depth" class="text-danger"></span>
                </div>
                <div class="col-12 col-md-6 mb-3">
                    <label class="form-label fw-bold">
                        Duration (minutes)
                    </label>
                    <input asp-for="DurationMinutes" type="number" class="form-control" placeholder="e.g. 30" />
                    <span asp-validation-for="DurationMinutes" class="text-danger"></span>
                </div>
            </div>
            <div class="d-grid mt-2">
                <button type="submit" class="btn storm-primary-btn btn-lg">
                    🔍 Find Storm
                </button>
            </div>
        </form>
    </div>
</div>
<br />

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="alert storm-success-message text-center mx-3">
        @Model.Message
    </div>
}

@if (Model != null && Model.StationName != null)
{
    <div class="card border-0 shadow-lg rounded-4 mb-4 mx-3">
        <div class="card-body p-3 p-md-4">
            <h5 class="storm-section-title text-center mb-4">
                📍 Station Information
            </h5>
            <div class="row g-4">
                <!-- Station details -->
                <div class="col-12 col-md-6">
                    <div class="station-info-item">
                        <div class="station-info-label">
                            Rainfall Monitoring Station
                        </div>
                        <div class="station-info-value">
                            @Model.StationName
                        </div>
                    </div>
                    <div class="station-info-item">
                        <div class="station-info-label">
                            Latitude
                        </div>
                        <div class="station-info-value">
                            @Model.Latitude?.ToString("F6")
                        </div>
                    </div>
                    <div class="station-info-item">
                        <div class="station-info-label">
                            Longitude
                        </div>
                        <div class="station-info-value">
                            @Model.Longitude?.ToString("F6")
                        </div>
                    </div>
                    <div class="station-info-item">
                        <div class="station-info-label">
                            Total Days
                        </div>
                        <div class="station-info-value">
                            @Model.TotalDays days
                        </div>
                    </div>
                </div>
                <!-- Station map -->
                <div class="col-12 col-md-6">
                    <div id="stationMap"
                         class="station-map rounded">
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="card border-0 shadow-lg rounded-4 mb-4 mx-3">
        <div class="card-body p-3 p-md-4">
            <h5 class="storm-section-title text-center mb-3">
                📊 Overview
            </h5>
            <div class="overview-chart-wrapper">
                <canvas id="overviewChart"></canvas>
            </div>
        </div>
    </div>
}

@if (Model.Results != null && Model.Results.Count > 0)
{
    <h4 class="storm-section-title mb-4 text-center px-3">

        🌧 Storm Found:
        @Model.Results.Count storm(s) matching criteria
    </h4>
    <div id="stormCarousel" class="carousel slide px-1" data-bs-ride="false" data-bs-touch="false" data-bs-interval="false">
        <div class="carousel-inner">
            @for (int i = 0; i < Model.Results.Count; i++)
            {
                var storm = Model.Results[i];
                <div class="carousel-item @(i == 0 ? "active" : "")">
                    <div class="storm-result-card shadow-sm p-3 p-md-4 mb-4 mx-2">
                        <!-- Storm title -->
                        <h5 class="storm-title text-center mb-3 fs-6 fs-md-5">
                            Storm @(i + 1):
                            @storm.StartTime.ToString("dd/MM/yyyy")
                            –
                            @storm.EndTime.ToString("dd/MM/yyyy")
                        </h5>
                        <!-- Total rainfall -->
                        <div class="text-center mb-4">
                            <div class="storm-rainfall">
                                <strong>
                                    Total Rainfall:
                                </strong>
                                <span class="ms-1">
                                    @Math.Round(storm.TotalRainfall, 2) mm
                                </span>
                            </div>
                        </div>
                        <div class="row g-4 mb-4">
                            <div class="col-12">
                                <div class="chart-wrapper">
                                    <canvas id="rainChart_@i"></canvas>
                                </div>
                            </div>
                        </div>
                        <div class="row g-4 mb-4">
                            <div class="col-12 d-flex justify-content-center">
                                <div class="satellite-section text-center w-100">
                                    <div class="satellite-title mb-3">
                                        Storm Satellite Image
                                        <span class="small">
                                            (@storm.MidTime.ToString("dd/MM/yyyy HH:mm"))
                                        </span>
                                    </div>
                                    @if (Model.Latitude.HasValue && Model.Longitude.HasValue)
                                    {
                                        var lat = Model.Latitude.Value;
                                        var lon = Model.Longitude.Value;

                                        var minLatE = lat - 20;
                                        var maxLatE = lat + 20;
                                        var minLonE = lon - 20;
                                        var maxLonE = lon + 20;

                                        //Eumetsat
                                        var dtE = storm.MidTime.ToUniversalTime();

                                        int minutesE = (dtE.Minute / 15) * 15;

                                        var validTimeE =
                                            new DateTime(
                                                dtE.Year,
                                                dtE.Month,
                                                dtE.Day,
                                                dtE.Hour,
                                                minutesE,
                                                0,
                                                DateTimeKind.Utc);

                                        var eumetsatTime =
                                            validTimeE.ToString(
                                                "yyyy-MM-ddTHH:mmZ");

                                        var eumetsatUrl =
                                            "https://view.eumetsat.int/geoserver/wms" +
                                            "?SERVICE=WMS&VERSION=1.3.0&REQUEST=GetMap" +
                                            "&LAYERS=msg_fes:ir108&FORMAT=image/png&CRS=EPSG:4326" +
                                            $"&BBOX={minLatE},{minLonE},{maxLatE},{maxLonE}" +
                                            "&WIDTH=700&HEIGHT=500" +
                                            $"&TIME={eumetsatTime}";

                                        //NASA GIBS
                                        var dtN = storm.MidTime;

                                        int roundedMinutes = (int)(Math.Round(dtN.Minute / 10.0) * 10);

                                        if (roundedMinutes == 60)
                                        {
                                            dtN = dtN.AddHours(1);
                                            roundedMinutes = 0;
                                        }

                                        var roundedMid =
                                            new DateTime(
                                                dtN.Year,
                                                dtN.Month,
                                                dtN.Day,
                                                dtN.Hour,
                                                0,
                                                0)
                                            .AddMinutes(roundedMinutes);

                                        var gibsStartDate =
                                            new DateTime(2000, 2, 24);

                                        var nasaGibsUrl =
                                            "https://gibs.earthdata.nasa.gov/wms/epsg4326/best/wms.cgi" +
                                            "?SERVICE=WMS&REQUEST=GetMap&VERSION=1.3.0" +
                                            "&LAYERS=MODIS_Terra_CorrectedReflectance_TrueColor" +
                                            "&FORMAT=image/jpeg&CRS=EPSG:4326" +
                                            $"&BBOX={minLatE},{minLonE},{maxLatE},{maxLonE}" +
                                            "&WIDTH=700&HEIGHT=500" +
                                            $"&TIME={roundedMid:yyyy-MM-ddTHH:mm:ssZ}";

                                        var eumetsatStart =
                                            new DateTime(
                                                2020,
                                                9,
                                                1,
                                                0,
                                                0,
                                                0,
                                                DateTimeKind.Utc);

                                        var eumetsatEnd =
                                            new DateTime(
                                                2026,
                                                4,
                                                13,
                                                8,
                                                0,
                                                0,
                                                DateTimeKind.Utc);

                                        bool showEumetsat = validTimeE >= eumetsatStart && validTimeE <= eumetsatEnd;
                                        bool showNasa = roundedMid >= gibsStartDate;

                                        @if (!Model.Latitude.HasValue || !Model.Longitude.HasValue)
                                        {
                                            <p class="text-muted mt-3">
                                                No Image Detected.
                                            </p>
                                        }
                                        else if (!showEumetsat && !showNasa)
                                        {
                                            <p class="text-muted fst-italic mt-4">
                                                No Satellite Image Available
                                                (Date too early or unsupported)
                                            </p>
                                        }
                                        else
                                        {
                                            <div class="row g-3 justify-content-center">
                                                <!-- EUMETSAT -->
                                                @if (showEumetsat)
                                                {
                                                    <div class="col-12 @(showNasa ? "col-md-6" : "") text-center">
                                                        <div class="fw-bold mb-2 small">
                                                            EUMETSAT Satellite Image
                                                        </div>
                                                        <img src="@eumetsatUrl"
                                                             class="img-fluid shadow-sm satellite-img"
                                                             alt="EUMETSAT Satellite Image" />
                                                    </div>
                                                }
                                                <!-- NASA -->
                                                @if (showNasa)
                                                {
                                                    <div class="col-12 @(showEumetsat ? "col-md-6" : "") text-center">
                                                        <div class="fw-bold mb-2 small">
                                                            NASA GIBS Satellite Image
                                                        </div>
                                                        <img src="@nasaGibsUrl"
                                                             class="img-fluid shadow-sm satellite-img"
                                                             alt="NASA GIBS Satellite Image" />
                                                    </div>
                                                }
                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <p class="text-muted">
                                            No Image Detected.
                                        </p>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="text-center mb-4">
                            <form asp-action="Download" method="post">
                                <input type="hidden" name="stormJson" value='@System.Text.Json.JsonSerializer.Serialize(storm)' />
                                <input type="hidden" name="stormNumber" value="@(i + 1)" />
                                <button type="submit" class="btn btn-link storm-download-btn">
                                    ↓ Download Data
                                </button>
                            </form>
                        </div>
                        <div class="storm-table-container mt-2">
                            <table class="table table-sm table-striped table-bordered mb-0">
                                <thead class="table-dark">
                                    <tr>
                                        <th>
                                            Time
                                        </th>
                                        <th>
                                            Rainfall (mm)
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in storm.EventData)
                                    {
                                        <tr>
                                            <td>
                                                @item.Time.ToString("dd/MM/yyyy HH:mm")
                                            </td>
                                            <td>
                                                @Math.Round(item.Rainfall, 2)
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <div class="carousel-nav-row text-center mt-3 mb-4 d-flex justify-content-center gap-3">
                        @if (i > 0)
                        {
                            <button class="carousel-arrow-btn" type="button" data-bs-target="#stormCarousel" data-bs-slide="prev">
                                ← Previous
                            </button>
                        }

                        @if (i < Model.Results.Count - 1)
                        {
                            <button class="carousel-arrow-btn" type="button" data-bs-target="#stormCarousel" data-bs-slide="next">
                                Next →
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

    <script>
        @if (Model.Latitude.HasValue && Model.Longitude.HasValue)
        {
            <text>
                    var map =
                    L.map('stationMap')
                    .setView(
                    [@Model.Latitude.Value,@Model.Longitude.Value],
                    13
                    );

                    L.tileLayer(
                    'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',
                    {
                        attribution:
                    '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
                            }
                    ).addTo(map);

                    L.marker(
                    [@Model.Latitude.Value,
                                @Model.Longitude.Value]
                    )
                    .addTo(map)
                    .bindPopup(
                    "@(Model.StationName ?? "Station")"
                    )
                    .openPopup();
            </text>
        }
    </script>

    @if (Model.DailyTotals != null && Model.DailyTotals.Count > 0)
    {
        <script>
            (function() {
                function cssVar(name) {
                    return getComputedStyle(document.documentElement)
                    .getPropertyValue(name)
                    .trim();
                }

                function themeColors() {
                    return {
                        text:
                            cssVar('--text') ||
                            '#212529',
                        muted:
                            cssVar('--muted') ||
                            '#6c757d',
                        border:
                            cssVar('--border') ||
                            '#dee2e6',
                        primary:
                            cssVar('--primary') ||
                            '#007bff',
                        card:
                            cssVar('--card') ||
                            '#f7f7f7'
                    };
                }

                const dailyLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                    Model.DailyTotals.Select(d => d.Date))
                );

                const dailyValues = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                    Model.DailyTotals.Select(d => d.Total))
                );

                const stormWindows = @Html.Raw(
                    System.Text.Json.JsonSerializer.Serialize(
                        (Model.Results ?? new List<StormResult>()).Select(s => new
                        {
                            start = s.StartTime.ToString("yyyy-MM-dd"),
                            end = s.EndTime.ToString("yyyy-MM-dd")
                        })
                    )
                );

                let activeStormIndex = 0;
                const highlightPlugin = {id: 'stormHighlight',
                    afterDraw(chart) {
                        if (!stormWindows.length)
                            return;

                        const {
                            ctx,
                            chartArea,
                            scales
                        } = chart;

                        const xScale = scales.x;
                        const totalBars = dailyLabels.length;

                        if (totalBars < 2)
                            return;

                        const px0 = xScale.getPixelForValue(0);
                        const px1 = xScale.getPixelForValue(1);

                        const slotW = Math.abs(px1 - px0);
                        const half = slotW / 2;

                        stormWindows.forEach(
                            (storm, idx) => {const si = dailyLabels.findIndex(d => d >= storm.start);

                                if (si < 0)
                                    return;

                                let ei = si;

                                for (
                                    let k =
                                        dailyLabels.length - 1;
                                    k >= si;
                                    k--
                                ) {
                                    if (
                                        dailyLabels[k] <=
                                        storm.end
                                    ) {
                                        ei = k;
                                        break;
                                    }
                                }

                                const x1 = xScale.getPixelForValue(si) - half;
                                const x2 = xScale.getPixelForValue(ei) + half;

                                const w = Math.max(slotW, x2 - x1);
                                const y = chartArea.top;

                                const h = chartArea.bottom - chartArea.top;

                                const isActive = idx === activeStormIndex;

                                ctx.save();
                                ctx.fillStyle = isActive
                                ? 'rgba(255, 200, 0, 0.30)'
                                : 'rgba(255, 200, 0, 0.08)';

                                ctx.strokeStyle = isActive
                                ? 'rgba(255, 180, 0, 1)'
                                : 'rgba(255, 200, 0, 0.40)';

                                ctx.lineWidth = isActive ? 2 : 1;
                                ctx.fillRect(x1, y, w, h);
                                ctx.strokeRect(x1, y, w, h);
                                ctx.restore();
                            }
                        );
                    }
                };

                function buildOverviewChart() {
                    const c = themeColors();

                    const canvas = document.getElementById('overviewChart');

                    if (!canvas)
                        return null;

                    return new Chart(
                        canvas.getContext('2d'),
                        {
                            type: 'bar',
                            data: {
                                labels:
                                    dailyLabels,
                                datasets: [
                                    {
                                        label: 'Daily Rainfall (mm)',
                                        data: dailyValues,
                                        backgroundColor: c.primary.replace(')',', 0.75)').replace('rgb','rgba'),
                                        borderColor: c.primary,
                                        borderWidth: 0,
                                        barPercentage: 1.0,
                                        categoryPercentage: 1.0
                                    }
                                ]
                            },
                            options: {
                                responsive: true,
                                maintainAspectRatio: false,
                                animation: false,
                                plugins: {
                                    legend: {
                                        display: true,
                                        labels: {
                                            color: themeColors().text,
                                            font: {
                                                size: 11
                                            },
                                            boxWidth: 12,
                                            padding: 10,
                                            generateLabels(chart) {
                                                const defaults =
                                                    Chart
                                                        .defaults
                                                        .plugins
                                                        .legend
                                                        .labels
                                                        .generateLabels(
                                                            chart
                                                        );
                                                defaults.push({
                                                    text: 'Storm Event',
                                                    fillStyle: 'rgba(255, 200, 0, 0.30)',
                                                    strokeStyle: 'rgba(255, 180, 0, 1)',
                                                    lineWidth: 2,
                                                    hidden: false,
                                                    index: -1
                                                });
                                                return defaults;
                                            }
                                        }
                                    },
                                    title: {
                                        display: true,
                                        text: '@Html.Raw(Model.StationName?.Replace("'", "\\'") ?? "") — Complete Rainfall Record',
                                        color: themeColors().text,
                                        font: {
                                            size: 13
                                        }
                                    },
                                    tooltip: {
                                        callbacks: {
                                            title: items => items[0].label,
                                            label: item => `${Number(item.raw).toFixed(2)} mm`
                                        }
                                    }
                                },
                                scales: {
                                    x: {
                                        ticks: {
                                            color: themeColors().muted,
                                            autoSkip: true,
                                            maxTicksLimit: window.innerWidth < 600 ? 5 : 15,
                                            maxRotation: 45,
                                            minRotation: 0,
                                            font: {
                                                size: window.innerWidth < 600 ? 9 : 11
                                            },
                                            callback(val, idx) {
                                                const raw = dailyLabels[idx];
                                                if (!raw)
                                                    return '';

                                                const d = new Date(raw);

                                                if (isNaN(d))
                                                    return raw.substring(0,7);

                                                return d.toLocaleString('en-GB',
                                                    {
                                                        month:'short',
                                                        year:'numeric'
                                                    }
                                                );
                                            }
                                        },
                                        grid: {
                                            display: false
                                        }
                                    },
                                    y: {
                                        beginAtZero: true,
                                        title: {
                                            display: window.innerWidth >= 480,
                                            text:'Rainfall (mm)',
                                            color:themeColors().muted,
                                            font: {
                                                size: 11
                                            }
                                        },
                                        ticks: {
                                            color:
                                                themeColors().muted,
                                            font: {
                                                size:window.innerWidth < 600 ? 9 : 11
                                            },
                                            callback: v => Number(v).toFixed(0)
                                        },
                                        grid: {
                                            color: themeColors().border
                                        }
                                    }
                                }
                            },
                            plugins: [highlightPlugin]
                        }
                    );
                }

                let overviewChart = buildOverviewChart();

                if (window.matchMedia) {
                    window.matchMedia('(prefers-color-scheme: dark)')
                        .addEventListener(
                            'change',
                            () => {
                                if (overviewChart)
                                    overviewChart.destroy();

                                overviewChart =
                                    buildOverviewChart();

                                overviewChart.update();
                            }
                        );
                }

                const carousel = document.getElementById('stormCarousel');

                if (carousel) {
                    carousel.addEventListener('slid.bs.carousel',
                        function(e) {
                            activeStormIndex = e.to;
                            if (overviewChart)
                                overviewChart.update();
                            createChart(e.to);
                        }
                    );
                }

                window.overviewChart = overviewChart;

                window.setActiveStorm = function(idx) {
                    activeStormIndex = idx;

                    if (overviewChart) {
                        overviewChart.update();
                    }
                };

                @if (Model.Results != null && Model.Results.Count > 0)
                {
                    <text>
                        const storms = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                            Model.Results.Select(storm => new {
                                labels = storm.EventData.Select(d => d.Time.ToString("HH:mm")),
                                values = storm.EventData.Select(d => Math.Round(d.Rainfall,2)),
                                returnPeriod = storm.ReturnPeriod
                            })
                        )
                        );

                        const charts = {};

                        function createChart(index) {
                            if (charts[index])
                            return;

                            const storm = storms[index];

                            const canvas = document.getElementById(`rainChart_${index}`);

                            if (!canvas)
                            return;

                            const c = themeColors();

                            charts[index] = new Chart(canvas.getContext('2d'),
                            {
                                type: 'bar',
                                data: {
                                    labels:storm.labels,
                                    datasets: [
                                    {
                                        label:'Rainfall (mm)',
                                        data: storm.values,
                                        backgroundColor: c.primary.replace(')',', 0.75)').replace('rgb','rgba'),
                                        borderColor: c.primary,
                                        borderWidth:1
                                    }]
                                },
                                options:{
                                    responsive: true,
                                    maintainAspectRatio:false,
                                    plugins:{
                                        title:{
                                            display: true,
                                            text:storm.returnPeriod,
                                            color: c.text,
                                            font:{
                                                size: 15
                                            }
                                        },
                                        legend:{
                                            display: false
                                        }
                                    },
                                    scales:{
                                        x:{
                                            ticks:{
                                                color: c.muted,
                                                autoSkip:true,
                                                maxTicksLimit:10,
                                                maxRotation:45,
                                                minRotation:0,
                                                font: {
                                                    size: 11
                                                }
                                            },
                                            grid: {
                                                color:c.border
                                            }
                                        },
                                        y:{
                                            beginAtZero: true,
                                            ticks:{
                                                color:c.muted,
                                                callback:value => Number(value).toFixed(2),
                                                font:{
                                                    size: 11
                                                }
                                            },
                                            grid:{
                                                color:c.border
                                            }
                                        }
                                    }
                                }
                            });
                        }
                            
                        createChart(0);
                            
                        document.querySelectorAll('.storm-table-container')
                        .forEach(
                            function (table) {
                                table.addEventListener('wheel',
                                function(e) {
                                    e.stopPropagation();
                                },
                                {
                                    passive: true
                                });
                                table.addEventListener('touchmove',
                                function (e) {
                                    e.stopPropagation();
                                },
                                {
                                    passive: true
                                });
                            }
                        );

                    </text>
                }
            })();
        </script>
    }
}

<style>
    body {
        background: var(--bg);
        color: var(--text);
    }

    .card {
        background: var(--card);
        color: var(--text);
        border: 1px solid var(--border);
        transition: background-color 0.2s ease, border-color 0.2s ease;
    }

    .card-body {
        color: var(--text);
    }

    .card h1,
    .card h2,
    .card h3,
    .card h4,
    .card h5,
    .card h6,
    .card p,
    .card div,
    .card span,
    .card strong,
    .card label {
        color: var(--text);
    }

    .storm-search-card {
        border-radius: 16px !important;
    }

    .storm-page-title {
        color: var(--primary) !important;
        font-weight: 700;
        letter-spacing: 0.2px;
    }

    .form-label {
        color: var(--text);
        font-weight: 600;
    }

    .form-control,
    .form-select {
        background: var(--card-inner);
        color: var(--text);
        border: 1px solid var(--border);
