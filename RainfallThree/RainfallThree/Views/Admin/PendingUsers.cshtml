@model UserViewModel

<h2>Pending User Approvals</h2>

@if (!Model.PendingUsers.Any())
{
    <p>No users awaiting approval.</p>
}
else
{
    <div class="table-responsive">
        <table class="table table-bordered table-sm">
            <thead>
                <tr>
                    <th>Email</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.PendingUsers)
                {
                    <tr>
                        <td>@user.Email</td>
                        <td>
                            <span class="badge bg-warning text-dark">Pending</span>
                        </td>
                        <td>
                            <form asp-action="Approve" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@user.Id" />
                                <button type="submit" class="btn btn-success btn-sm">
                                    Approve
                                </button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<hr />

<h2>All Users</h2>

@if (!Model.AllUsers.Any())
{
    <p>No users found.</p>
}
else
{
   <div class="table-responsive">
      <table class="table table-bordered table-sm">
            <thead>
                <tr>
                    <th>Email</th>
                    <th>Last Login</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var user in Model.AllUsers)
                {
                    <tr>
                        <td>@user.Email</td>
                        <td>@user.LastLoginDate?.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>

                        <td>
                            @if (user.IsApproved)
                            {
                                <span class="badge bg-success">Approved</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Not Approved</span>
                            }
                        </td>


                        <td>
                            @if (user.IsApproved)
                            {
                                <form asp-action="Deny" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@user.Id" />
                                    <button type="submit" class="btn btn-danger btn-sm">
                                        Deny
                                    </button>
                                </form>
                            }
                            else
                            {
                                <form asp-action="Approve" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@user.Id" />
                                    <button type="submit" class="btn btn-success btn-sm">
                                        Approve
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}