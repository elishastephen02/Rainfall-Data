@{
    ViewData["Title"] = "Instructions";
}

<div class="instructions-page">
    <div class="card instructions-main-card shadow-lg border-0 mb-4">
        <div class="instructions-header">
            <div class="instructions-header-icon">
                <i class="bi bi-info-circle"></i>
            </div>
            <div>
                <h4 class="mb-1">
                    PCSWMM Import Instructions
                </h4>
                <p class="mb-0">
                    Follow the steps below to import the generated rainfall data into your PCSWMM model.
                </p>
            </div>
        </div>
        <div class="card-body p-3 p-md-4">
            <div class="instruction-intro mb-4">
                <div class="intro-icon">
                    <i class="bi bi-lightbulb"></i>
                </div>
                <div>
                    <strong>Before you begin</strong>
                    <p class="mb-0 mt-1">
                        Make sure you have downloaded the generated folder and have access
                        to your PCSWMM model directory.
                    </p>
                </div>
            </div>
            <div class="instruction-step">
                <div class="step-number">
                    1
                </div>
                <div class="step-content">
                    <h5>Unzip the generated folder</h5>
                    <p>
                        Unzip the downloaded folder within your PCSWMM model folder.
                    </p>
                </div>
            </div>
            <div class="instruction-step">
                <div class="step-number">
                    2
                </div>
                <div class="step-content">
                    <h5>Locate your model file</h5>
                    <p>
                        In your PCSWMM model directory, locate your
                        <strong><code>.INP</code></strong> file.
                    </p>
                </div>
            </div>
            <div class="instruction-step">
                <div class="step-number">
                    3
                </div>
                <div class="step-content">
                    <h5>Open the <strong>.INP</strong> file</h5>
                    <p>
                        Open the <strong><code>.INP</code></strong> file using
                        <strong>TextEdit</strong> or <strong>Notepad</strong>.
                    </p>
                </div>
            </div>
            <div class="instruction-group">
                <div class="group-heading">
                    <span class="group-number">
                        4–6
                    </span>
                    <h5>
                        Add the Raingages
                    </h5>
                </div>
                <ol>
                    <li>
                        From the SWMM <strong>Raingages</strong> list, copy all
                        raingages.
                    </li>
                    <li>
                        In the <strong><code>.INP</code></strong> file, locate the heading
                        <code>[RAINGAGES]</code>.
                    </li>
                    <li>
                        Paste the copied raingages underneath the
                        <code>[RAINGAGES]</code> heading.
                    </li>
                </ol>
                <div class="example-box">
                    <div class="example-heading">
                        <i class="bi bi-code-slash"></i>
                        Example
                    </div>
                    <pre><code>[RAINGAGES]
;;Name           Format    Interval SCF      Source
;;-------------- --------- -------- -------- ----------</code></pre>
                </div>
            </div>
            <div class="instruction-group">
                <div class="group-heading">
                    <span class="group-number">
                        7–9
                    </span>
                    <h5>
                        Add the Timeseries
                    </h5>
                </div>
                <ol>
                    <li>
                        From the SWMM <strong>Timeseries</strong> list, copy all
                        timeseries.
                    </li>
                    <li>
                        In the <strong><code>.INP</code></strong> file, locate the heading
                        <code>[TIMESERIES]</code>.
                    </li>
                    <li>
                        Paste the copied timeseries underneath the
                        <code>[TIMESERIES]</code> heading.
                    </li>
                </ol>
                <div class="example-box">
                    <div class="example-heading">
                        <i class="bi bi-code-slash"></i>
                        Example
                    </div>
                    <pre><code>[TIMESERIES]
;;Name           Date       Time       Value
;;-------------- ---------- ---------- ----------</code></pre>
                </div>
            </div>
            <div class="instruction-step">
                <div class="step-number">
                    10
                </div>
                <div class="step-content">
                    <h5>Save the <strong>.INP</strong> file</h5>
                    <p>
                        Save the changes made to the
                        <strong><code>.INP</code></strong> file.
                    </p>
                </div>
            </div>
            <div class="instruction-step">
                <div class="step-number">
                    11
                </div>
                <div class="step-content">
                    <h5>Open the model in PCSWMM</h5>
                    <p>
                        Open the updated
                        <strong><code>.INP</code></strong> file in PCSWMM.
                    </p>
                </div>
            </div>
            <div class="instruction-group">
                <div class="group-heading">
                    <span class="group-number">
                        12–14
                    </span>
                    <h5>
                        Verify the Raingages
                    </h5>
                </div>
                <ol class="mb-0">
                    <li>
                        Click on <strong>Map</strong>.
                    </li>
                    <li>
                        Click on <strong>Raingages</strong>.
                    </li>
                    <li>
                        Check that the raingages have been loaded correctly.
                    </li>
                </ol>
            </div>
        </div>
        <div class="instructions-footer">
            <i class="bi bi-check-circle-fill"></i>
            <span>
                Once the raingages have been verified, your PCSWMM model is ready
                for use with the imported rainfall data.
            </span>
        </div>
    </div>
</div>

<style>
    .instructions-page {
        color: var(--text);
        max-width: 1100px;
        margin: 0 auto;
        padding: 20px 15px;
    }

    .instructions-main-card {
        background: var(--card);
        color: var(--text);
        border: 1px solid var(--border) !important;
        border-radius: 18px !important;
        overflow: hidden;
    }

    .instructions-header {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 20px 24px;
        background: var(--primary);
        color: #fff;
    }

        .instructions-header h4 {
            color: #fff !important;
            font-weight: 700;
        }

        .instructions-header p {
            color: rgba(255, 255, 255, 0.88) !important;
            font-size: 0.9rem;
        }

    .instructions-header-icon {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.15);
        border: 1px solid rgba(255, 255, 255, 0.25);
        border-radius: 12px;
        font-size: 1.4rem;
        flex-shrink: 0;
        color: #fff !important;
    }

        .instructions-header-icon i {
            color: #fff !important;
        }

    .instruction-intro {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 15px 18px;
        background: var(--card-inner);
        border: 1px solid var(--border);
        border-left: 4px solid var(--primary);
        border-radius: 10px;
    }

        .instruction-intro strong {
            color: var(--text);
            font-weight: 700;
        }

        .instruction-intro p {
            color: var(--muted);
            font-size: 0.9rem;
        }

    .intro-icon {
        color: var(--primary);
        font-size: 1.2rem;
        margin-top: 1px;
    }

    .instruction-step {
        display: flex;
        align-items: flex-start;
        gap: 15px;
        padding: 16px 14px;
        margin-bottom: 12px;
        border: 1px solid transparent;
        border-radius: 12px;
        transition: background-color 0.2s ease, border-color 0.2s ease, transform 0.15s ease;
    }

        .instruction-step:hover {
            background: var(--card-inner); 
            border-color: var(--border);
            transform: translateX(2px);
        }

    .step-number {
        width: 38px;
        height: 38px;
        min-width: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--primary);
        color: #fff;
        border-radius: 50%;
        font-weight: 700;
        font-size: 0.95rem;
        box-shadow: 0 3px 8px rgba(0, 0, 0, 0.12);
    }

    .step-content {
        flex: 1;
    }

        .step-content h5 {
            margin-bottom: 5px;
            color: var(--text) !important;
            font-weight: 700;
            font-size: 1rem;
        }

        .step-content p {
            margin-bottom: 0;
            color: var(--muted) !important;
            font-size: 0.92rem;
            line-height: 1.6;
        }

    .instruction-group {
        background: var(--card-inner);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 18px;
        margin: 20px 0;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

        .instruction-group:hover {
            border-color: var(--primary);
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.06);
        }

    .group-heading {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 15px;
    }

        .group-heading h5 {
            margin: 0;
            color: var(--text) !important;
            font-weight: 700;
            font-size: 1rem;
        }

    .group-number {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 48px;
        height: 30px;
        padding: 0 10px;
        background: var(--primary);
        color: #fff;
        border-radius: 8px;
        font-size: 0.8rem;
        font-weight: 700;
    }

    .instruction-group ol {
        margin: 0;
        padding-left: 25px;
        color: var(--text);
    }

    .instruction-group li {
        color: var(--text) !important;
        padding-left: 5px;
        margin-bottom: 10px;
        font-size: 0.92rem;
        line-height: 1.55;
    }

        .instruction-group li:last-child {
            margin-bottom: 0;
        }

    .instruction-group strong {
        color: var(--text) !important;
    }

    .instructions-page code {
        background: var(--card);
        color: var(--primary) !important;
        border: 1px solid var(--border);
        border-radius: 5px;
        padding: 2px 6px;
        font-size: 0.86em;
    }

    .example-box {
        margin-top: 16px;
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 10px;
        overflow: hidden;
    }

    .example-heading {
        display: flex;
        align-items: center;
        gap: 7px;
        padding: 8px 12px;
        background: var(--card-inner);
        border-bottom: 1px solid var(--border);
        color: var(--muted);
        font-size: 0.78rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.4px;
    }

        .example-heading i {
            color: var(--primary);
        }

    .example-box pre {
        margin: 0;
        padding: 12px 14px;
        background: var(--card);
        overflow-x: auto;
        border: 0;
    }

        .example-box pre code {
            padding: 0;
            background: transparent;
            border: 0;
            color: var(--text) !important;
            font-family: Consolas, "Courier New", monospace;
            font-size: 0.8rem;
            white-space: pre;
        }

    .instructions-footer {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 16px 20px;
        background: var(--card-inner);
        border-top: 1px solid var(--border);
        color: var(--muted);
        text-align: center;
        font-size: 0.85rem;
    }

        .instructions-footer i {
            color: #28a745;
            font-size: 1.1rem;
            flex-shrink: 0;
        }

    @@media (max-width: 767px) {

        .instructions-page {
            padding: 10px 8px;
        }

        .instructions-header {
            padding: 16px;
        }

        .instructions-header-icon {
            width: 42px;
            height: 42px;
            font-size: 1.2rem;
        }

        .instructions-header h4 {
            font-size: 1.05rem;
        }

        .instructions-header p {
            font-size: 0.8rem;
        }

        .instruction-step {
            gap: 11px;
            padding: 13px 8px;
        }

        .step-number {
            width: 34px;
            height: 34px;
            min-width: 34px;
            font-size: 0.85rem;
        }

        .step-content h5 {
            font-size: 0.95rem;
        }

        .step-content p,
        .instruction-group li {
            font-size: 0.86rem;
        }

        .instruction-group {
            padding: 14px;
            margin: 16px 0;
        }

        .group-heading h5 {
            font-size: 0.95rem;
        }

        .example-box pre {
            padding: 10px;
        }

            .example-box pre code {
                font-size: 0.72rem;
            }

        .instructions-footer {
            flex-direction: column;
            gap: 6px;
            padding: 14px;
        }
    }

    @@media (max-width: 480px) {

        .instructions-page {
            padding: 5px;
        }

        .instructions-main-card {
            border-radius: 13px !important;
        }

        .instructions-header {
            gap: 10px;
        }

        .instructions-header-icon {
            width: 38px;
            height: 38px;
            font-size: 1rem;
        }

        .instruction-intro {
            padding: 12px;
        }

        .instruction-group {
            padding: 12px;
        }

        .group-number {
            min-width: 43px;
            height: 28px;
        }
    }
</style>