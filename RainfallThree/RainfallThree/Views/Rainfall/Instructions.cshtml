@{
    ViewData["Title"] = "Instructions";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@500;600;700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

<div class="instructions-page">
    <div class="instructions-card">

        <!-- HEADER -->
        <div class="instructions-header">
            <div class="instructions-header-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon"><circle cx="12" cy="12" r="10" /><path d="M12 16v-4" /><path d="M12 8h.01" /></svg>
            </div>
            <div>
                <h2>PCSWMM Import Instructions</h2>
                <p>Follow the step-by-step procedure below to integrate generated rainfall data into your local PCSWMM model directory.</p>
            </div>
        </div>

        <div class="instructions-body">

            <!-- BEFORE YOU BEGIN ALERT -->
            <div class="instruction-intro">
                <div class="intro-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5" /><path d="M9 18h6" /><path d="M10 22h4" /></svg>
                </div>
                <div>
                    <strong>Before you begin</strong>
                    <p>Ensure you have downloaded and unzipped the generated dataset folder and have write access to your local PCSWMM project path.</p>
                </div>
            </div>

            <div class="timeline-container">

                <!-- STEP 1 -->
                <div class="instruction-step">
                    <div class="step-badge">1</div>
                    <div class="step-content">
                        <h5>Unzip the generated folder</h5>
                        <p>Extract the downloaded archive directory directly inside your primary PCSWMM model directory.</p>
                    </div>
                </div>

                <!-- STEP 2 -->
                <div class="instruction-step">
                    <div class="step-badge">2</div>
                    <div class="step-content">
                        <h5>Locate your model file</h5>
                        <p>In your PCSWMM model directory, find your project's primary configuration <code>.INP</code> file.</p>
                    </div>
                </div>

                <!-- STEP 3 -->
                <div class="instruction-step">
                    <div class="step-badge">3</div>
                    <div class="step-content">
                        <h5>Open the <code>.INP</code> file</h5>
                        <p>Open the <code>.INP</code> file using a standard plain text editor like <strong>VS Code</strong>, <strong>Notepad++</strong>, or <strong>Notepad</strong>.</p>
                    </div>
                </div>

                <!-- STEP 4-6 GROUP -->
                <div class="instruction-group">
                    <div class="group-heading">
                        <span class="group-badge">4–6</span>
                        <h5>Add the Raingages</h5>
                    </div>
                    <ol>
                        <li>From the SWMM <strong>Raingages</strong> list output, copy all formatted raingage entries.</li>
                        <li>In your opened <code>.INP</code> file, search for the section heading <code>[RAINGAGES]</code>.</li>
                        <li>Paste the copied raingage records directly beneath the header lines.</li>
                    </ol>
                    <div class="example-box">
                        <div class="example-heading">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-sm"><polyline points="16 18 22 12 16 6" /><polyline points="8 6 2 12 8 18" /></svg>
                            Structure Example
                        </div>
                        <pre><code>[RAINGAGES]
;;Name           Format    Interval SCF      Source
;;-------------- --------- -------- -------- ----------</code></pre>
                    </div>
                </div>

                <!-- STEP 7-9 GROUP -->
                <div class="instruction-group">
                    <div class="group-heading">
                        <span class="group-badge">7–9</span>
                        <h5>Add the Timeseries</h5>
                    </div>
                    <ol>
                        <li>From the SWMM <strong>Timeseries</strong> list output, copy all generated time-series data.</li>
                        <li>In the <code>.INP</code> file, locate the header <code>[TIMESERIES]</code>.</li>
                        <li>Paste the copied time-series blocks directly under the <code>[TIMESERIES]</code> section.</li>
                    </ol>
                    <div class="example-box">
                        <div class="example-heading">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-sm"><polyline points="16 18 22 12 16 6" /><polyline points="8 6 2 12 8 18" /></svg>
                            Structure Example
                        </div>
                        <pre><code>[TIMESERIES]
;;Name           Date       Time       Value
;;-------------- ---------- ---------- ----------</code></pre>
                    </div>
                </div>

                <!-- STEP 10 -->
                <div class="instruction-step">
                    <div class="step-badge">10</div>
                    <div class="step-content">
                        <h5>Save the <code>.INP</code> file</h5>
                        <p>Save all changes made to the modified <code>.INP</code> text file and close the text editor.</p>
                    </div>
                </div>

                <!-- STEP 11 -->
                <div class="instruction-step">
                    <div class="step-badge">11</div>
                    <div class="step-content">
                        <h5>Open the model in PCSWMM</h5>
                        <p>Launch PCSWMM and open the newly saved <code>.INP</code> model file.</p>
                    </div>
                </div>

                <!-- STEP 12-14 GROUP -->
                <div class="instruction-group">
                    <div class="group-heading">
                        <span class="group-badge">12–14</span>
                        <h5>Verify the Raingages</h5>
                    </div>
                    <ol>
                        <li>Navigate to the <strong>Map</strong> tab in the main interface.</li>
                        <li>Select <strong>Raingages</strong> from the visual layer options.</li>
                        <li>Verify that all raingages display correctly and map coordinates match your spatial inputs.</li>
                    </ol>
                </div>

            </div>
        </div>

        <!-- FOOTER -->
        <div class="instructions-footer">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="icon icon-success"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg>
            <span>Once verified, your PCSWMM model is ready to run simulations with the imported design rainfall data.</span>
        </div>

    </div>
</div>

<style>
    .instructions-page {
        --primary-soft: rgba(13, 110, 253, 0.08);
        --primary-soft-strong: rgba(13, 110, 253, 0.16);
        --success-color: #10b981;
        --success-soft: rgba(16, 185, 129, 0.12);
        width: 100%;
        max-width: 960px;
        margin: 0 auto;
        padding: 24px 16px 60px;
        font-family: 'Inter', sans-serif;
        color: var(--text);
    }

        .instructions-page h2,
        .instructions-page h5,
        .instructions-header,
        .group-badge,
        .step-badge {
            font-family: 'Manrope', sans-serif;
        }

    .icon {
        width: 22px;
        height: 22px;
        flex-shrink: 0;
        vertical-align: middle;
    }

    .icon-sm {
        width: 16px;
        height: 16px;
    }

    .icon-success {
        color: var(--success-color);
    }

    /* CARD CONTAINER */
    .instructions-card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 20px;
        box-shadow: 0 10px 30px var(--shadow);
        overflow: hidden;
    }

    /* HEADER */
    .instructions-header {
        display: flex;
        align-items: flex-start;
        gap: 18px;
        padding: 32px 36px;
        background: var(--primary);
        color: #ffffff;
    }

        .instructions-header h2 {
            margin: 0 0 6px 0;
            color: #ffffff !important;
            font-size: 1.45rem;
            font-weight: 800;
            letter-spacing: -0.01em;
        }

        .instructions-header p {
            margin: 0;
            color: rgba(255, 255, 255, 0.88) !important;
            font-size: 0.95rem;
            line-height: 1.5;
        }

    .instructions-header-icon {
        width: 50px;
        height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.15);
        border: 1px solid rgba(255, 255, 255, 0.25);
        border-radius: 14px;
        flex-shrink: 0;
        color: #ffffff;
    }

    /* BODY */
    .instructions-body {
        padding: 36px;
    }

    /* INTRO BANNER */
    .instruction-intro {
        display: flex;
        align-items: flex-start;
        gap: 16px;
        padding: 18px 22px;
        background: var(--card-inner);
        border: 1px solid var(--border);
        border-left: 4px solid var(--primary);
        border-radius: 14px;
        margin-bottom: 32px;
    }

        .instruction-intro strong {
            display: block;
            color: var(--text);
            font-weight: 700;
            font-size: 0.95rem;
            margin-bottom: 4px;
        }

        .instruction-intro p {
            margin: 0;
            color: var(--muted);
            font-size: 0.9rem;
            line-height: 1.55;
        }

    .intro-icon {
        color: var(--primary);
        margin-top: 2px;
    }

    /* TIMELINE & STEPS */
    .timeline-container {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .instruction-step {
        display: flex;
        align-items: flex-start;
        gap: 18px;
        padding: 18px 20px;
        border-radius: 14px;
        border: 1px solid transparent;
        transition: background 0.15s ease, border-color 0.15s ease, transform 0.15s ease;
    }

        .instruction-step:hover {
            background: var(--card-inner);
            border-color: var(--border);
            transform: translateX(3px);
        }

    .step-badge {
        width: 36px;
        height: 36px;
        min-width: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--primary);
        color: #ffffff;
        border-radius: 50%;
        font-weight: 800;
        font-size: 0.9rem;
        box-shadow: 0 4px 10px var(--primary-soft-strong);
    }

    .step-content {
        flex: 1;
        padding-top: 4px;
    }

        .step-content h5 {
            margin: 0 0 6px 0;
            color: var(--text) !important;
            font-weight: 700;
            font-size: 1rem;
        }

        .step-content p {
            margin: 0;
            color: var(--muted) !important;
            font-size: 0.92rem;
            line-height: 1.6;
        }

    /* STEP GROUPS */
    .instruction-group {
        background: var(--card-inner);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 24px;
        margin: 12px 0;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

        .instruction-group:hover {
            border-color: var(--primary-soft-strong);
            box-shadow: 0 6px 20px var(--shadow);
        }

    .group-heading {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 18px;
    }

        .group-heading h5 {
            margin: 0;
            color: var(--text) !important;
            font-weight: 800;
            font-size: 1.05rem;
        }

    .group-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 52px;
        height: 32px;
        padding: 0 12px;
        background: var(--primary);
        color: #ffffff;
        border-radius: 10px;
        font-size: 0.85rem;
        font-weight: 800;
        box-shadow: 0 3px 8px var(--primary-soft-strong);
    }

    .instruction-group ol {
        margin: 0;
        padding-left: 24px;
    }

    .instruction-group li {
        color: var(--text);
        padding-left: 4px;
        margin-bottom: 10px;
        font-size: 0.92rem;
        line-height: 1.6;
    }

        .instruction-group li:last-child {
            margin-bottom: 0;
        }

    /* INLINE CODE & CODE BLOCKS */
    .instructions-page code {
        font-family: 'JetBrains Mono', monospace;
        background: var(--primary-soft);
        color: var(--primary) !important;
        border: 1px solid var(--primary-soft-strong);
        border-radius: 6px;
        padding: 2px 7px;
        font-size: 0.82em;
        font-weight: 600;
    }

    .example-box {
        margin-top: 20px;
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 12px;
        overflow: hidden;
    }

    .example-heading {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px 16px;
        background: var(--card-inner);
        border-bottom: 1px solid var(--border);
        color: var(--muted);
        font-family: 'Manrope', sans-serif;
        font-size: 0.75rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

        .example-heading .icon {
            color: var(--primary);
        }

    .example-box pre {
        margin: 0;
        padding: 16px;
        background: var(--card);
        overflow-x: auto;
    }

        .example-box pre code {
            padding: 0;
            background: transparent;
            border: none;
            color: var(--text) !important;
            font-size: 0.82rem;
            line-height: 1.5;
            white-space: pre;
        }

    /* FOOTER */
    .instructions-footer {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        padding: 20px 36px;
        background: var(--card-inner);
        border-top: 1px solid var(--border);
        color: var(--text);
        text-align: center;
        font-size: 0.9rem;
        font-weight: 500;
    }

    /* RESPONSIVE STYLES */
    @@media (max-width: 767.98px) {
        .instructions-header {
            padding: 24px;
            gap: 14px;
        }

        .instructions-header-icon {
            width: 42px;
            height: 42px;
        }

        .instructions-header h2 {
            font-size: 1.2rem;
        }

        .instructions-header p {
            font-size: 0.85rem;
        }

        .instructions-body {
            padding: 20px 16px;
        }

        .instruction-intro {
            padding: 14px 16px;
        }

        .instruction-step {
            gap: 14px;
            padding: 12px;
        }

        .step-badge {
            width: 32px;
            height: 32px;
            min-width: 32px;
            font-size: 0.82rem;
        }

        .instruction-group {
            padding: 16px;
        }

        .instructions-footer {
            padding: 18px 20px;
            flex-direction: column;
            gap: 8px;
        }
    }
</style>