@model RainfallThree.Models.SearchRainfallViewModel

<h2 class="text-center" style="color:#005E83">☔ Design Rainfall Data</h2>

<form class="rainfall-form" method="post" asp-action="Search" asp-controller="Rainfall" enctype="multipart/form-data">

    <h3>Select Location on Map or Draw Area Polygon</h3>
    <div id="map" style="height: 400px; width: 100%; margin-bottom: 20px;"></div>
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script async src="https://maps.googleapis.com/maps/api/js?key=AIzaSyCOOGU5sHBREmUAIpPYv1THtaM-t0SgE8I&libraries=places"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <link rel="stylesheet" href="https://unpkg.com/leaflet-draw/dist/leaflet.draw.css" />
    <script src="https://unpkg.com/leaflet-draw/dist/leaflet.draw.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>

    <input type="hidden" asp-for="PolygonGeoJson" id="PolygonGeoJson" />

    <script>
        window.addEventListener('load', function () {

        // initialise map
        var durbanCenter = [-29.8587, 31.0218];
        var map = L.map('map').setView(durbanCenter, 12);

        var southWest = L.latLng(-30.2, 30.6);
        var northEast = L.latLng(-29.5, 31.5);
        var durbanBounds = L.latLngBounds(southWest, northEast);

        map.setMaxBounds(durbanBounds);

        map.on('drag', function () {
        map.panInsideBounds(durbanBounds, { animate: false });
        });

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; OpenStreetMap contributors'
        }).addTo(map);

        var drawnItems = new L.FeatureGroup();
        map.addLayer(drawnItems);

        var marker;

        function placeMarker(lat, lng) {
        if (marker) map.removeLayer(marker);
        marker = L.marker([lat, lng]).addTo(map);
        map.setView([lat, lng], 14);
        }

        var uploadedLayer;

        // Upload button click
        document.getElementById("uploadAreaBtn").addEventListener("click", async function () {

        var fileInput = document.getElementById("areaFileInput");

        if (!fileInput.files || fileInput.files.length === 0) {
        alert("Please select a file first.");
        return;
        }

        var file = fileInput.files[0];
        var formData = new FormData();
        formData.append("file", file);

        try {
        const response = await fetch("/Rainfall/UploadAreaFile", {
        method: "POST",
        body: formData
        });

        if (!response.ok) {
        alert("File upload failed.");
        return;
        }

        const geojsonText = await response.text();
        const geojson = JSON.parse(geojsonText);

        // remove old layer
        if (uploadedLayer) {
        map.removeLayer(uploadedLayer);
        }

        // draw polygon
        uploadedLayer = L.geoJSON(geojson, {
        style: { color: "red", weight: 3 }
        }).addTo(map);

        drawnItems.clearLayers();

        // add each layer individually
        uploadedLayer.eachLayer(function (layer) {
        drawnItems.addLayer(layer);
        });

        map.fitBounds(uploadedLayer.getBounds());

        // store GeoJSON in hidden field
        document.getElementById("PolygonGeoJson").value =
        JSON.stringify(geojson);

        // extract coordinates → fill inputs (optional centroid)
        var coords;

        function extractCoords(geojson) {
        if (geojson.type === "FeatureCollection") {
        return geojson.features[0].geometry.coordinates[0];
        }

        if (geojson.type === "Feature") {
        return geojson.geometry.coordinates[0];
        }

        if (geojson.type === "Polygon") {
        return geojson.coordinates[0];
        }

        if (geojson.type === "MultiPolygon") {
        return geojson.coordinates[0][0];
        }

        throw "Unsupported GeoJSON format";
        }

        var coords = extractCoords(geojson);

        var lats = coords.map(c => c[1]);
        var lons = coords.map(c => c[0]);

        var avgLat = lats.reduce((a,b)=>a+b,0) / lats.length;
        var avgLon = lons.reduce((a,b)=>a+b,0) / lons.length;

        if (!isNaN(avgLat) && !isNaN(avgLon)) {
        updateInputsFromCoordinates(avgLat, avgLon);
        console.log("Inputs updated:", avgLat, avgLon);
        } else {
        console.error("Invalid centroid values");
        }

        alert("Polygon loaded successfully. Now click Search.", true);

        } catch (err) {
        console.error(err);
        alert("Error processing file: " + err.message);
        console.error(err);
        }
        });

        // coordinate conversion
        function degMinToDecimal(deg, min) {
        if (deg === null || deg === "" || isNaN(deg)) return null;
        return parseFloat(deg) + (parseFloat(min) || 0) / 60;
        }

        function decimalToDegMin(value) {
        var abs = Math.abs(value);
        var deg = Math.floor(abs);
        var min = Math.round((abs - deg) * 60);

        if (min === 60) {
        deg += 1;
        min = 0;
        }

        return { deg: deg, min: min };
        }

        function updateInputsFromCoordinates(lat, lng) {
        var latParts = decimalToDegMin(lat);
        var lngParts = decimalToDegMin(lng);

        document.getElementById("LATDEG").value = latParts.deg;
        document.getElementById("LATMIN").value = latParts.min;
        document.getElementById("LONGDEG").value = lngParts.deg;
        document.getElementById("LONGMIN").value = lngParts.min;
        }

        function updateMarkerFromInputs() {
        var latDeg = parseFloat(document.getElementById("LATDEG").value);
        var latMin = parseFloat(document.getElementById("LATMIN").value);
        var lngDeg = parseFloat(document.getElementById("LONGDEG").value);
        var lngMin = parseFloat(document.getElementById("LONGMIN").value);

        if (!isNaN(latDeg) && !isNaN(lngDeg)) {
        var lat = -degMinToDecimal(latDeg, latMin);
        var lng = degMinToDecimal(lngDeg, lngMin);
        placeMarker(lat, lng);
        }
        }

        //message
        function showMessage(msg, isError = true) {
        var box = document.getElementById("addressMessage");
        if (!box) return;
        box.style.color = isError ? "red" : "green";
        box.innerText = msg;
        }

        //preload markers
        var latDeg = @(Model.LATDEG.HasValue? Model.LATDEG.Value.ToString() : "NaN");
        var latMin = @(Model.LATMIN.HasValue? Model.LATMIN.Value.ToString() : "0");
        var lngDeg = @(Model.LONGDEG.HasValue? Model.LONGDEG.Value.ToString() : "NaN");
        var lngMin = @(Model.LONGMIN.HasValue? Model.LONGMIN.Value.ToString() : "0");

        if (!isNaN(latDeg) && !isNaN(lngDeg)) {
        var lat = -degMinToDecimal(latDeg, latMin);
        var lng = degMinToDecimal(lngDeg, lngMin);
        placeMarker(lat, lng);
        }

        //input listener
        ["LATDEG", "LATMIN", "LONGDEG", "LONGMIN"].forEach(function (id) {
        var el = document.getElementById(id);
        if (el) {
        el.addEventListener("change", function () {
        clearPolygon();
        updateMarkerFromInputs();
        });
        }
        });

        //map click
        map.on('click', function (e) {
        clearPolygon();
        placeMarker(e.latlng.lat, e.latlng.lng);
        updateInputsFromCoordinates(e.latlng.lat, e.latlng.lng);
        });

        //address search
        var btn = document.getElementById("searchAddressBtn");

        if (btn) {
        btn.addEventListener("click", async function (e) {
        e.preventDefault();

        showMessage("");

        var address = document.getElementById("Address").value;

        if (!address || address.trim() === "") {
        showMessage("Please enter an address.");
        return;
        }

        try {
        const apiKey = "AIzaSyC688eU0nYXp4K6Qx_HV3dj4dLLaWJPBNM";

        var url =
        "https://maps.googleapis.com/maps/api/geocode/json?address=" +
        encodeURIComponent(address) +
        "&key=" + apiKey;

        var response = await fetch(url);
        var data = await response.json();

        if (!data.results || data.results.length === 0) {
        showMessage("Address not found.");
        return;
        }

        var location = data.results[0].geometry.location;

        clearPolygon();

        placeMarker(location.lat, location.lng);
        updateInputsFromCoordinates(location.lat, location.lng);

        showMessage("Address found!", false);

        } catch (error) {
        console.error(error);
        showMessage("Error finding address.");
        }
        });
        }

        //draw polygon
        var drawnItems = new L.FeatureGroup();
        map.addLayer(drawnItems);

        var drawControl = new L.Control.Draw({
        draw: {
        polygon: true,
        rectangle: false,
        circle: false,
        circlemarker: false,
        marker: false,
        polyline: false
        },
        edit: {
        featureGroup: drawnItems
        }
        });

        map.addControl(drawControl);

        map.on(L.Draw.Event.CREATED, function (e) {
        drawnItems.clearLayers();
        drawnItems.addLayer(e.layer);

        var geojson = e.layer.toGeoJSON();
        document.getElementById("PolygonGeoJson").value = JSON.stringify(geojson);
        });

        //restore polygon
        var savedPolygon = document.getElementById("PolygonGeoJson").value;

        if (savedPolygon) {
        try {
        var geo = JSON.parse(savedPolygon);

        var layer = L.geoJSON(geo, {
        style: { color: "red", weight: 3 }
        });

        layer.addTo(map);
        drawnItems.addLayer(layer);
        map.fitBounds(layer.getBounds());

        } catch (e) {
        console.log("Invalid polygon JSON", e);
        }
        }

        function clearPolygon() {
        // remove drawn shapes
        if (drawnItems) {
        drawnItems.clearLayers();
        }

        // remove uploaded polygon layer
        if (uploadedLayer) {
        map.removeLayer(uploadedLayer);
        uploadedLayer = null;
        }

        // clear hidden field (VERY IMPORTANT)
        document.getElementById("PolygonGeoJson").value = "";

        console.log("Polygon cleared");
        }

        // GOOGLE ADDRESS AUTOCOMPLETE
        const addressInput = document.getElementById("Address");

        const autocomplete = new google.maps.places.Autocomplete(addressInput, {
        types: ["address"],
        componentRestrictions: { country: "za" }, // South Africa only
        strictBounds: false,
        fields: ["geometry", "formatted_address", "name"]
        });

        // Bias results toward Durban
        autocomplete.setBounds(
        new google.maps.LatLngBounds(
        new google.maps.LatLng(-30.2, 30.6),
        new google.maps.LatLng(-29.5, 31.5)
        )
        );

        autocomplete.addListener("place_changed", function () {

        const place = autocomplete.getPlace();

        if (!place.geometry) {
        showMessage("Address not found.");
        return;
        }

        const lat = place.geometry.location.lat();
        const lng = place.geometry.location.lng();

        clearPolygon();

        placeMarker(lat, lng);
        updateInputsFromCoordinates(lat, lng);

        showMessage("Address selected!", false);
        });


        });

        document.querySelector("form").addEventListener("submit", function () {

        // ALWAYS use drawnItems (this is what user sees)
        var allLayers = drawnItems.toGeoJSON();

        if (allLayers && allLayers.features && allLayers.features.length > 0) {
        document.getElementById("PolygonGeoJson").value =
        JSON.stringify(allLayers);
        console.log("Submitting polygon:", allLayers);
        } else {
        console.log("No polygon to submit");
        }
        });

        //download
        function prepareDownload() {
        var results = @Html.Raw(Json.Serialize(Model.Results));
        document.getElementById("ResultsJson").value = JSON.stringify(results);
        }
    </script>

    <fieldset>
        <legend>Search by Address</legend>
        <div class="form-group" style="margin-bottom: 15px;">
            <div class="address-row" style="display:flex; gap:10px; align-items:center;">
                <div id="addressMessage" style="color:red; font-weight:500;"></div>
                <input asp-for="Address" id="Address" placeholder="Enter in your address within Ethekwini region" style="flex:1; height:40px; padding:6px 10px; box-sizing:border-box; margin:0;" />
                <button type="button" id="searchAddressBtn" style="height:40px; padding:0 15px; box-sizing:border-box; white-space:nowrap; margin:0; line-height:40px;">
                    Find Address
                </button>
            </div>
        </div>
    </fieldset>

    <fieldset>
        <legend>Location</legend>
        <div class="form-grid">
            <div class="form-group">
                <label asp-for="LATDEG">Latitude Degree</label>
                <input asp-for="LATDEG" id="LATDEG" />
            </div>
            <div class="form-group">
                <label asp-for="LATMIN">Latitude Minute</label>
                <input asp-for="LATMIN" id="LATMIN" />
            </div>
            <div class="form-group">
                <label asp-for="LONGDEG">Longitude Degree</label>
                <input asp-for="LONGDEG" id="LONGDEG" />
            </div>
            <div class="form-group">
                <label asp-for="LONGMIN">Longitude Minute</label>
                <input asp-for="LONGMIN" id="LONGMIN" />
            </div>
        </div>
    </fieldset>

    <fieldset>
        <legend>Upload Area File</legend>

        <div class="form-group">
            <label>Upload Area File (GeoJSON, JSON, KML, KMZ)</label>

            <input type="file" id="areaFileInput" accept=".geojson,.json,.kml,.kmz" />

            <button type="button" id="uploadAreaBtn" style="margin-top:10px;">
                Upload
            </button>
        </div>
    </fieldset>

    <fieldset>
        <legend>Rainfall Return Period & Duration</legend>

        <div class="checkbox-grid">
            @foreach (var rp in Model.ReturnPeriodOptions.Where(x => !string.IsNullOrEmpty(x.Value)))
            {
                <label class="checkbox-item">
                    <input type="checkbox"
                           name="SelectedReturnPeriods"
                           value="@rp.Value"
                    @(Model.SelectedReturnPeriods?.Contains(int.Parse(rp.Value)) == true ? "checked" : "") />

                    @rp.Text
                </label>
            }
        </div>

        <div class="checkbox-grid">
            @foreach (var d in Model.DurationOptions.Where(x => !string.IsNullOrEmpty(x.Value)))
            {
                <label class="checkbox-item">
                    <input type="checkbox"
                           name="SelectedDurations"
                           value="@d.Value"
                    @(Model.SelectedDurations?.Contains(d.Value) == true ? "checked" : "") />

                    @d.Text
                </label>
            }
        </div>
    </fieldset>

    <button type="submit">Search</button>
</form>

@if (Model.Results != null && Model.Results.Any())
{
    <div class="results-container">
        <h3>Results (@Model.Results.Count)</h3>

        <div style="display:flex; justify-content:flex-end; gap:10px; margin-bottom:10px; padding-right:40px;">
            <form method="post" asp-action="Download" onsubmit="prepareDownload()">
                <input type="hidden" name="Index" value="@Model.Index" />
                <input type="hidden" name="LATDEG" value="@Model.LATDEG" />
                <input type="hidden" name="LATMIN" value="@Model.LATMIN" />
                <input type="hidden" name="LONGDEG" value="@Model.LONGDEG" />
                <input type="hidden" name="LONGMIN" value="@Model.LONGMIN" />
                @foreach (var rp in Model.SelectedReturnPeriods)
                {
                    <input type="hidden" name="SelectedReturnPeriods" value="@rp" />
                }

                @foreach (var d in Model.SelectedDurations)
                {
                    <input type="hidden" name="SelectedDurations" value="@d" />
                }
                <input type="hidden" name="ResultsJson" id="ResultsJson" />
                <button type="submit" style="background:none; border:none; padding:0; margin-right:40px; color:blue; text-decoration:underline; cursor:pointer;">
                    Download CSV
                </button>
                <button type="button" id="btnExportPCSWMM" style="background:none; border:none; padding:0; color:blue; text-decoration:underline; cursor:pointer;">
                        Export to PCSWMM
                </button>
            </form>
        </div>

        <div class="table-scroll-xy">
            <table>
                <thead>
                    <tr>
                        <th>Index</th>
                        <th>Lat Deg</th>
                        <th>Lat Min</th>
                        <th>Long Deg</th>
                        <th>Long Min</th>
                        <th>Return Period</th>

                        @if (!Model.SelectedDurations.Any())
                        {
                            <th>5 Min</th>
                            <th>10 Min</th>
                            <th>15 Min</th>
                            <th>30 Min</th>
                            <th>1 Hour</th>
                            <th>2 Hours</th>
                            <th>1 Day</th>
                            <th>3 Days</th>
                            <th>7 Days</th>
                        }
                        else
                        {
                            @foreach (var duration in Model.SelectedDurations)
                            {
                                <th>@duration Min</th>
                            }
                        }

                        <th>Source Sheet</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model.Results)
                    {
                        <tr>
                            <td>@item.Index</td>
                            <td>@item.Latdeg</td>
                            <td>@item.Latmin</td>
                            <td>@item.Longdeg</td>
                            <td>@item.Longmin</td>
                            <td>@item.ReturnPeriod</td>

                            @if (!Model.SelectedDurations.Any())
                            {
                                <td>@item._5Min?.ToString("0.00")</td>
                                <td>@item._10Min?.ToString("0.00")</td>
                                <td>@item._15Min?.ToString("0.00")</td>
                                <td>@item._30Min?.ToString("0.00")</td>
                                <td>@item._60Min?.ToString("0.00")</td>
                                <td>@item._120Min?.ToString("0.00")</td>
                                <td>@item._1440Min?.ToString("0.00")</td>
                                <td>@item._4320Min?.ToString("0.00")</td>
                                <td>@item._10080Min?.ToString("0.00")</td>
                            }
                            else
                            {
                                foreach (var duration in Model.SelectedDurations)
                                {
                                    <td>
                                        @{
                                            var value = duration switch
                                            {
                                                "5" => item._5Min,
                                                "10" => item._10Min,
                                                "15" => item._15Min,
                                                "30" => item._30Min,
                                                "60" => item._60Min,
                                                "120" => item._120Min,
                                                "1440" => item._1440Min,
                                                "4320" => item._4320Min,
                                                "10080" => item._10080Min,
                                                _ => null
                                            };
                                        }

                                        @value?.ToString("0.00")
                                    </td>
                                }
                            }

                            <td>@item.SourceSheet</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (Model.Results != null && Model.Results.Any())
{
    <div class="results-container">
        <h3>
            @(string.IsNullOrEmpty(Model.PolygonGeoJson)
                ? "Point Summary Statistics (Coordinates)"
                : "Area Summary Statistics (Polygon)")
        </h3>

        <hr>

        <div class="table-scroll">
            <table>
                <thead>
                    @if (!Model.SelectedDurations.Any())
                    {
                        <tr>
                            <th rowspan="2">Return Period</th>

                            <th colspan="3">5 Min</th>
                            <th colspan="3">10 Min</th>
                            <th colspan="3">15 Min</th>
                            <th colspan="3">30 Min</th>
                            <th colspan="3">1 Hour</th>
                            <th colspan="3">2 Hours</th>
                            <th colspan="3">1 Day</th>
                            <th colspan="3">3 Days</th>
                            <th colspan="3">7 Days</th>
                        </tr>
                        <tr>
                            @for (int i = 0; i < 9; i++)
                            {
                                <th>Min</th>
                                <th>Max</th>
                                <th>Avg</th>
                            }
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <th>Return Period</th>

                            @foreach (var duration in Model.SelectedDurations)
                            {
                                <th>Min @duration</th>
                                <th>Max @duration</th>
                                <th>Avg @duration</th>
                            }
                        </tr>
                    }
                </thead>
                <tbody>
                    @foreach (var item in Model.Summary)
                    {
                        <tr>
                            <td>@item.ReturnPeriod</td>

                            @if (!Model.SelectedDurations.Any())
                            {
                                <td>@item.Min5?.ToString("0.00")</td>
                                <td>@item.Max5?.ToString("0.00")</td>
                                <td>@item.Avg5?.ToString("0.00")</td>

                                <td>@item.Min10?.ToString("0.00")</td>
                                <td>@item.Max10?.ToString("0.00")</td>
                                <td>@item.Avg10?.ToString("0.00")</td>

                                <td>@item.Min15?.ToString("0.00")</td>
                                <td>@item.Max15?.ToString("0.00")</td>
                                <td>@item.Avg15?.ToString("0.00")</td>

                                <td>@item.Min30?.ToString("0.00")</td>
                                <td>@item.Max30?.ToString("0.00")</td>
                                <td>@item.Avg30?.ToString("0.00")</td>

                                <td>@item.Min60?.ToString("0.00")</td>
                                <td>@item.Max60?.ToString("0.00")</td>
                                <td>@item.Avg60?.ToString("0.00")</td>

                                <td>@item.Min120?.ToString("0.00")</td>
                                <td>@item.Max120?.ToString("0.00")</td>
                                <td>@item.Avg120?.ToString("0.00")</td>

                                <td>@item.Min1440?.ToString("0.00")</td>
                                <td>@item.Max1440?.ToString("0.00")</td>
                                <td>@item.Avg1440?.ToString("0.00")</td>

                                <td>@item.Min4320?.ToString("0.00")</td>
                                <td>@item.Max4320?.ToString("0.00")</td>
                                <td>@item.Avg4320?.ToString("0.00")</td>

                                <td>@item.Min10080?.ToString("0.00")</td>
                                <td>@item.Max10080?.ToString("0.00")</td>
                                <td>@item.Avg10080?.ToString("0.00")</td>
                            }
                            else
                            {
                                @foreach (var duration in Model.SelectedDurations)
                                {
                                    double? min = duration switch
                                    {
                                        "5" => item.Min5,
                                        "10" => item.Min10,
                                        "15" => item.Min15,
                                        "30" => item.Min30,
                                        "60" => item.Min60,
                                        "120" => item.Min120,
                                        "1440" => item.Min1440,
                                        "4320" => item.Min4320,
                                        "10080" => item.Min10080,
                                        _ => null
                                    };

                                    double? max = duration switch
                                    {
                                        "5" => item.Max5,
                                        "10" => item.Max10,
                                        "15" => item.Max15,
                                        "30" => item.Max30,
                                        "60" => item.Max60,
                                        "120" => item.Max120,
                                        "1440" => item.Max1440,
                                        "4320" => item.Max4320,
                                        "10080" => item.Max10080,
                                        _ => null
                                    };

                                    double? avg = duration switch
                                    {
                                        "5" => item.Avg5,
                                        "10" => item.Avg10,
                                        "15" => item.Avg15,
                                        "30" => item.Avg30,
                                        "60" => item.Avg60,
                                        "120" => item.Avg120,
                                        "1440" => item.Avg1440,
                                        "4320" => item.Avg4320,
                                        "10080" => item.Avg10080,
                                        _ => null
                                    };

                                    <td>@min?.ToString("0.00")</td>
                                    <td>@max?.ToString("0.00")</td>
                                    <td>@avg?.ToString("0.00")</td>
                                }
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
<div class="modal fade" id="exportModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content text-dark">
            <div class="modal-header">
                <h5 class="modal-title"> 
                    Export to PCSWMM 
                </h5> 
            </div> 
            <div class="modal-body"> 
                <p> Select the South African SCS type. </p> 
                <select id="stormType" class="form-select"> 
                    <option value="Type_1"> South Africa SCS Type 1 </option> 
                    <option value="Type_2"> South Africa SCS Type 2 </option> 
                    <option value="Both"> Both </option> 
                </select> 
                
                <br /> 
                <!-- PCSWMM Model Directory --> 
                <label for="modelFolderPath" class="form-label"> 
                    <strong>PCSWMM Model Directory</strong> 
                </label> 
                <input type="text" id="modelFolderPath" class="form-control" placeholder="C:\Users\YourName\Documents\YourModel" autocomplete="off" /> 
                <small class="text-muted"> 
                    Enter the full path to your PCSWMM model folder by opening your folder directly in Windows Explorer, coping the address bar and pasting it above. 
                </small>
                <br /> <br /> 
                <div class="alert alert-info"> 
                    <strong>NOTE:</strong> 
                    <br /><br /> 
                    The generated PCSWMM files will be packaged into a 
                    <strong>Generated_SWMM_Storms.zip</strong> file. 
                    <br /><br /> The ZIP will contain all generated <strong>.dat</strong> files, 
                    <strong>SWMM_Raingages_List.txt</strong> and <strong>SWMM_Timeseries_List.txt</strong>. 
                </div> 
            </div> 
            <div class="modal-footer"> 
                
                <button class="btn btn-secondary" data-bs-dismiss="modal"> Cancel </button> 
                <button class="btn btn-primary" id="btnGenerate"> Generate Files </button> 
            </div> 
        </div> 
    </div> 
</div> 

<!-- Progress Modal --> 
<div class="modal fade" id="progressModal" data-bs-backdrop="static" data-bs-keyboard="false"> 
    <div class="modal-dialog modal-dialog-centered"> 
        <div class="modal-content text-dark"> 
            <div class="modal-header"> 
                <h5> Generating PCSWMM Files </h5> 
            </div> 
            <div class="modal-body"> 
                <p id="progressText"> Preparing export... </p> 
                <div class="progress mb-3"> 
                    <div id="progressBar" class="progress-bar progress-bar-striped progress-bar-animated" style="width:0%"> 0% </div> 
                </div> 
                <table class="table table-sm"> 
                    <tr> 
                        <th>Total Files</th> 
                        <td id="totalFiles">0</td> 
                    </tr> 
                    <tr> 
                        <th>Completed</th> 
                        <td id="completedFiles">0</td> 
                    </tr> <tr> 
                        <th>Current File</th> 
                        <td id="currentFile"> Preparing... </td> 
                    </tr> 
                </table> 
            </div> 
        </div> 
    </div> 
</div> 

<!-- Complete Modal --> 
<div class="modal fade" id="completeModal"> 
    <div class="modal-dialog modal-dialog-centered"> 
        <div class="modal-content text-dark"> 
            <div class="modal-header"> 
                <h5> Export Complete </h5> 
            </div> 
            <div class="modal-body"> 
                <div class="alert alert-success"> ✔ Export completed successfully. 
                    <br /> <br /> 
                    <strong id="fileCount"></strong> PCSWMM files were generated. 
                </div> 
                <p> Click <strong>Download ZIP Files</strong>. 
                    <br /> <br /> Save the ZIP file inside your <b>PCSWMM Model</b> folder. 
                    <br /> <br /> The ZIP file is named: <br /> 
                    <strong> Generated_SWMM_Storms.zip </strong> 
                </p> 
                <button class="btn btn-success w-100" id="btnDownloadZip"> 
                    Download ZIP Files 
                </button>
                <hr /> 
            </div> 
            <div class="modal-footer"> 
                <button class="btn btn-primary" id="btnContinue" disabled> 
                    Continue to Instructions 
                </button> 
            </div> 
        </div> 
    </div> 
</div>
<script> 
   // PCSWMM EXPORT DATA 
    const exportResults = @Html.Raw(Json.Serialize(Model.Results)); 
    const selectedDurations = @Html.Raw(Json.Serialize(Model.SelectedDurations)); 
    let generatedZip = null; 
    let downloaded = false; 
    
    // BOOTSTRAP MODALS 
    const exportModal = 
    new bootstrap.Modal( document.getElementById("exportModal") ); 
    const progressModal = 
    new bootstrap.Modal( document.getElementById("progressModal") ); 
    const completeModal = 
    new bootstrap.Modal( document.getElementById("completeModal") ); 
    
    // OPEN EXPORT MODAL
    document .getElementById("btnExportPCSWMM")
    .addEventListener("click", function () { exportModal.show(); }); 
    
    // GENERATE PCSWMM FILES
    document .getElementById("btnGenerate")
    .addEventListener("click", async function () { 
        /* * Get model directory. */ 
        const modelFolderPath = document 
        .getElementById("modelFolderPath") 
        .value 
        .trim(); 
        
        /* * Make sure the user entered a path. */ 
        if (!modelFolderPath) { 
            alert( "Please enter your PCSWMM Model Directory." );
            return; 
        } 
        
        /* * Get storm type. */ 
        const stormType = document 
        .getElementById("stormType") 
        .value; 
        
        /* * Close export modal. */ 
        exportModal.hide(); 
        
        /* * Open progress modal. */ 
        progressModal.show(); 
        
        /* * Reset progress information. */ 
        document.getElementById("progressBar") 
        .style.width = "0%"; 
        
        document.getElementById("progressBar") 
        .innerHTML = "0%"; 
        
        document.getElementById("progressText")
        .innerHTML = "Preparing export..."; 
        
        document.getElementById("totalFiles")
        .innerHTML = "0"; 
        
        document.getElementById("completedFiles")
        .innerHTML = "0"; 

        document.getElementById("currentFile")
        .innerHTML = "Preparing..."; 
        
        try { 
            /* * Send export request. */ 
            const response = await fetch( "/Rainfall/GeneratePCSWMM", { 
                method: "POST", headers: 
                { "Content-Type": "application/json" }, 
                body: JSON.stringify({ 
                    stormType: stormType, 
                    results: exportResults, 
                    selectedDurations: selectedDurations, 
                    modelFolderPath: modelFolderPath }) }
            ); 
            
            /* * Handle server error. */ 
            if (!response.ok) { 
                const errorText = await response.text(); 
                progressModal.hide(); 
                alert( errorText || "Failed to generate PCSWMM files." ); 
                return; 
            } 
            
            /* * Get ZIP. */ 
            const zipBlob = await response.blob(); 

            /* * Create browser URL for ZIP. */ 
            generatedZip = URL.createObjectURL(zipBlob); 
            
            /* * Generation completed. */ 
            progressModal.hide(); 
            completeModal.show(); 
        } catch (err) { 
            console.error(err); 
            progressModal.hide(); 
            alert( "An error occurred while generating the PCSWMM files." ); }
    }); 
    
    // DOWNLOAD ZIP
document.getElementById("btnDownloadZip")
    .addEventListener("click", async function () {

        if (!generatedZip) {
            return;
        }

        try {
            // Ask the user where to save the ZIP
            const fileHandle = await window.showSaveFilePicker({
                suggestedName: "Generated_SWMM_Storms.zip",
                types: [
                    {
                        description: "ZIP files",
                        accept: {
                            "application/zip": [".zip"]
                        }
                    }
                ]
            });

            // Convert the generated ZIP URL into a Blob
            const response = await fetch(generatedZip);
            const blob = await response.blob();

            // Write the ZIP to the selected location
            const writable = await fileHandle.createWritable();
            await writable.write(blob);
            await writable.close();

            // Only mark as downloaded after successfully saving
            downloaded = true;

            // Enable Continue button
            updateContinueButton();

        } catch (error) {

            // User cancelled the Save As dialog
            if (error.name === "AbortError") {
                return;
            }

            console.error("Error saving ZIP:", error);
        }
    });
    
    // ENABLE CONTINUE AFTER DOWNLOAD
    function updateContinueButton() { 
        document.getElementById("btnContinue")
        .disabled = !downloaded; } 
        
    // CONTINUE TO INSTRUCTIONS
    document.getElementById("btnContinue")
    .addEventListener("click", function () {
        window.location = "/Rainfall/Instructions"; }); 
        
    // UPDATE PROGRESS
    function updateProgress(progress) { 
        document.getElementById("progressBar")
        .style.width = progress.percentage + "%"; 
        document.getElementById("progressBar")
        .innerHTML = progress.percentage + "%"; 
        document.getElementById("totalFiles")
        .innerHTML = progress.totalFiles; 
        document.getElementById("completedFiles")
        .innerHTML = progress.filesCompleted; 
        document.getElementById("currentFile")
        .innerHTML = progress.currentFile; 
        document.getElementById("progressText")
        .innerHTML = "<strong>Generating:</strong><br>" + 
        progress.currentFile + "<br><br>" + 
        progress.filesCompleted + " of " + 
        progress.totalFiles + " files completed."; } 
</script>

