        max-width: 850px;
    }

    .step-label {
        display: flex;
        align-items: center;
        gap: 12px;
        margin: 6px 0 16px;
    }

        .step-label h3 {
            margin: 0;
            font-family: 'Manrope', sans-serif;
            font-size: 1.05rem;
            font-weight: 700;
        }

        .step-label p {
            margin: 2px 0 0;
            color: var(--muted);
            font-size: .82rem;
        }

    .rainfall-card,
    .results-card {
        background: var(--card);
        color: var(--text);
        border: 1px solid var(--border);
        border-radius: 18px;
        padding: 26px;
        box-shadow: 0 6px 20px var(--shadow);
        transition: transform .2s ease, box-shadow .2s ease;
        margin-bottom: 22px;
    }

        .rainfall-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 16px 34px var(--shadow);
        }

    .map-card {
        margin-bottom: 24px;
    }

    .rainfall-two-column {
        display: grid;
        grid-template-columns: 1fr;
        gap: 22px;
        margin-bottom: 22px;
    }

        .rainfall-two-column > .rainfall-card {
            width: 100%;
            box-sizing: border-box;
        }

    .section-header {
        display: flex;
        align-items: center;
        gap: 13px;
        margin-bottom: 18px;
    }

        .section-header.compact {
            margin-bottom: 16px;
        }

    .section-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 44px;
        height: 44px;
        flex-shrink: 0;
        border-radius: 12px;
        background: var(--primary-soft);
        color: var(--primary);
    }

    .section-header h2 {
        margin: 0;
        font-size: 1.1rem;
        font-weight: 700;
    }

    .section-header p {
        margin: 3px 0 0;
        color: var(--muted);
        font-size: .82rem;
    }

    .map-wrapper {
        position: relative;
        overflow: hidden;
        border-radius: 14px;
        border: 1px solid var(--border);
    }

    #map {
        width: 100%;
        height: 440px;
    }

    .map-search-overlay {
        position: absolute;
        top: 14px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 1000;
        display: flex;
        justify-content: center;
        pointer-events: none;
        width: 100%;
    }

    .map-search-box {
        pointer-events: auto;
        width: 520px;
        max-width: calc(100% - 30px);
        height: 48px;
        box-sizing: border-box;
        background: var(--card);
        border-radius: 12px;
        box-shadow: 0 8px 22px rgba(15,23,42,.16);
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 0 14px;
    }

        .map-search-box .icon {
            color: var(--muted-soft);
        }

        .map-search-box input {
            flex: 1;
            border: none;
            outline: none;
            background: transparent;
            font-family: 'Inter', sans-serif;
            font-size: .9rem;
            color: var(--text);
        }

            .map-search-box input::placeholder {
                color: var(--muted-soft);
            }

    .map-wrapper .leaflet-control-container {
        z-index: 900;
    }

    .map-wrapper .leaflet-control {
        z-index: 900;
    }

    .map-search-btn {
        display: flex;
        align-items: center;
        gap: 7px;
        height: 48px;
        padding: 0 18px;
        background: var(--primary);
        color: #fff;
        border: none;
        border-radius: 12px;
        font-family: 'Inter', sans-serif;
        font-weight: 700;
        font-size: .85rem;
        cursor: pointer;
        box-shadow: 0 8px 20px rgba(13,110,253,.3);
        flex-shrink: 0;
    }

        .map-search-btn:hover {
            background: var(--primary-hover);
        }

    .address-message {
        min-height: 18px;
        margin-top: 10px;
        font-size: .85rem;
        font-weight: 600;
    }

    .map-help {
        display: flex;
