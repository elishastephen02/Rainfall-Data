@model RainfallThree.Models.SearchRainfallViewModel

@{
    ViewData["Title"] = "Design Rainfall Data";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<link rel="stylesheet" href="https://unpkg.com/leaflet-draw/dist/leaflet.draw.css" />
<script async src="https://maps.googleapis.com/maps/api/js?key=AIzaSyCOOGU5sHBREmUAIpPYv1THtaM-t0SgE8I&libraries=places"></script>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="https://unpkg.com/leaflet-draw/dist/leaflet.draw.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>

<div class="rainfall-page">
    <div class="rainfall-page-header">
        <div class="rainfall-title-icon">
            ☔
        </div>
        <div>
            <h1>Design Rainfall Data</h1>
            <p>
                Select a location, define an area, and retrieve detailed
                rainfall information for your selected return periods and durations.
            </p>
        </div>
    </div>

    <!-- SEARCH FORM -->
    <form class="rainfall-form" method="post" asp-action="Search" asp-controller="Rainfall" enctype="multipart/form-data">
        <input type="hidden" asp-for="PolygonGeoJson" id="PolygonGeoJson" />
        <!-- MAP CARD -->
        <section class="rainfall-card map-card">
            <div class="section-header">
                <div class="section-icon">
                    📍
                </div>
                <div>
                    <h2>Select Location</h2>
                    <p>
                        Select a location on the map or draw an area polygon.
                    </p>
                </div>
            </div>
            <div class="map-wrapper">
                <div id="map"></div>
            </div>
            <div class="map-help">
                <span>
                    🖱️ Click the map to select a location
                </span>
                <span>
                    ✏️ Use the polygon tool to define an area
                </span>
            </div>
        </section>

        <!-- ADDRESS + COORDINATES -->
        <div class="rainfall-two-column">
            <!-- ADDRESS CARD -->
            <section class="rainfall-card">
                <div class="section-header compact">
                    <div class="section-icon">
                        🔎
                    </div>
                    <div>
                        <h2>Search by Address</h2>
                        <p>
                            Find a location within the eThekwini region.
                        </p>
                    </div>
                </div>
                <div id="addressMessage"
                     class="address-message">
                </div>
                <div class="address-search">
                    <input asp-for="Address" id="Address" class="modern-input" placeholder="Enter an address within the eThekwini region" autocomplete="off" />
                    <button type="button" id="searchAddressBtn" class="modern-button">
                        <span>🔎</span>
                        Find Address
                    </button>
                </div>
            </section>

            <!-- COORDINATES CARD -->
            <section class="rainfall-card">
                <div class="section-header compact">
                    <div class="section-icon">
                        🧭
                    </div>
                    <div>
                        <h2>Location Coordinates</h2>
                        <p>
                            Enter latitude and longitude manually.
                        </p>
                    </div>
                </div>
                <div class="coordinate-grid">
                    <div class="input-group-modern">
                        <label asp-for="LATDEG">
                            Latitude Degree
                        </label>
                        <input asp-for="LATDEG" id="LATDEG" class="modern-input" placeholder="Degrees" />
                    </div>
                    <div class="input-group-modern">
                        <label asp-for="LATMIN">
                            Latitude Minute
                        </label>
                        <input asp-for="LATMIN" id="LATMIN" class="modern-input" placeholder="Minutes" />
                    </div>
                    <div class="input-group-modern">
                        <label asp-for="LONGDEG">
                            Longitude Degree
                        </label>
                        <input asp-for="LONGDEG" id="LONGDEG" class="modern-input" placeholder="Degrees" />
                    </div>
                    <div class="input-group-modern">
                        <label asp-for="LONGMIN">
                            Longitude Minute
                        </label>
                        <input asp-for="LONGMIN" id="LONGMIN" class="modern-input"placeholder="Minutes" />
                    </div>
                </div>
            </section>
        </div>

        <!-- UPLOAD + RAINFALL OPTIONS -->
        <div class="rainfall-two-column">
            <!-- UPLOAD AREA -->
            <section class="rainfall-card">
                <div class="section-header compact">
                    <div class="section-icon">
                        🗺️
                    </div>
                    <div>
                        <h2>Upload Area</h2>
                        <p>
                            Upload a polygon defining the area to analyse.
                        </p>
                    </div>
                </div>
                <div class="upload-area">
                    <div class="upload-icon">
                        📁
                    </div>
                    <div class="upload-text">
                        <strong>
                            Upload an area file
                        </strong>
                        <span>
                            GeoJSON, JSON, KML or KMZ
                        </span>
                    </div>
                    <input type="file" id="areaFileInput" accept=".geojson,.json,.kml,.kmz" class="file-input" />
                </div>
                <button type="button" id="uploadAreaBtn" class="modern-button secondary-button">
                    📤 Upload Area
                </button>
            </section>

            <!-- RAINFALL OPTIONS -->
            <section class="rainfall-card">
                <div class="section-header compact">
                    <div class="section-icon">
                        🌧️
                    </div>
                    <div>
                        <h2>Rainfall Options</h2>
                        <p>
                            Select the return periods and durations required.
                        </p>
                    </div>
                </div>

                <!-- RETURN PERIODS -->
                <div class="option-section">
                    <h3>
                        Return Period
                    </h3>
                    <div class="checkbox-grid">
                        @foreach (var rp in Model.ReturnPeriodOptions.Where(x => !string.IsNullOrEmpty(x.Value)))
                        {
                            <label class="checkbox-item">
                                <input type="checkbox" name="SelectedReturnPeriods" value="@rp.Value" @(Model.SelectedReturnPeriods?.Contains(int.Parse(rp.Value)) == true ? "checked" : "") />
                                <span>
                                    @rp.Text
                                </span>
                            </label>
                        }
                    </div>
                </div>

                <!-- DURATIONS -->
                <div class="option-section">
                    <h3>
                        Duration
                    </h3>
                    <div class="checkbox-grid">
                        @foreach (var d in Model.DurationOptions.Where(x => !string.IsNullOrEmpty(x.Value)))
                        {
                            <label class="checkbox-item">
                                <input type="checkbox" name="SelectedDurations" value="@d.Value" @(Model.SelectedDurations?.Contains(d.Value) == true ? "checked" : "") />
                                <span>
                                    @d.Text
                                </span>
                            </label>
                        }
                    </div>
                </div>
            </section>
        </div>

        <!-- SEARCH BUTTON -->
        <div class="search-button-container">
            <button type="submit" class="search-button">
                <span>🔍</span>
                Search Rainfall Data
            </button>
        </div>
    </form>

    <!-- RESULTS -->
    @if (Model.Results != null && Model.Results.Any())
    {
        <section class="results-card">
            <div class="results-header">
                <div>
                    <h2>
                        Rainfall Results
                    </h2>
                    <p>
                        @Model.Results.Count result(s) found
                    </p>
                </div>
                <div class="results-actions">
                    <form method="post" asp-action="Download" onsubmit="prepareDownload()">
                        <input type="hidden" name="Index" value="@Model.Index" />
                        <input type="hidden" name="LATDEG" value="@Model.LATDEG" />
                        <input type="hidden" name="LATMIN" value="@Model.LATMIN" />
                        <input type="hidden" name="LONGDEG" value="@Model.LONGDEG" />
                        <input type="hidden" name="LONGMIN" value="@Model.LONGMIN" />
                        
                        @foreach (var rp in Model.SelectedReturnPeriods)
                        {
                            <input type="hidden" name="SelectedReturnPeriods" value="@rp" />
                        }

                        @foreach (var d in Model.SelectedDurations)
                        {
                            <input type="hidden" name="SelectedDurations" value="@d" />
                        }

                        <input type="hidden" name="ResultsJson" id="ResultsJson" />
                        <button type="submit" class="result-button">
                            ⬇ Download CSV
                        </button>
                        <button type="button" id="btnExportPCSWMM" class="result-button primary-result-button">
                            ⚡ Export to PCSWMM
                        </button>
                    </form>
                </div>
            </div>

            <!-- DETAIL TABLE -->
            <div class="table-scroll-xy">
                <table class="modern-table">
                    <thead>
                        <tr>
                            <th>Index</th>
                            <th>Lat Deg</th>
                            <th>Lat Min</th>
                            <th>Long Deg</th>
                            <th>Long Min</th>
                            <th>Return Period</th>

                            @if (!Model.SelectedDurations.Any())
                            {
                                <th>5 Min</th>
                                <th>10 Min</th>
                                <th>15 Min</th>
                                <th>30 Min</th>
                                <th>1 Hour</th>
                                <th>2 Hours</th>
                                <th>1 Day</th>
                                <th>3 Days</th>
                                <th>7 Days</th>
                            }
                            else
                            {
                                @foreach (var duration in Model.SelectedDurations)
                                {
                                    <th>
                                        @duration Min
                                    </th>
                                }
                            }

                            <th>Source Sheet</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Results)
                        {
                            <tr>
                                <td>@item.Index</td>
                                <td>@item.Latdeg</td>
                                <td>@item.Latmin</td>
                                <td>@item.Longdeg</td>
                                <td>@item.Longmin</td>
                                <td>
                                    <span class="return-period-badge">
                                        @item.ReturnPeriod
                                    </span>
                                </td>

                                @if (!Model.SelectedDurations.Any())
                                {
                                    <td>@item._5Min?.ToString("0.00")</td>
                                    <td>@item._10Min?.ToString("0.00")</td>
                                    <td>@item._15Min?.ToString("0.00")</td>
                                    <td>@item._30Min?.ToString("0.00")</td>
                                    <td>@item._60Min?.ToString("0.00")</td>
                                    <td>@item._120Min?.ToString("0.00")</td>
                                    <td>@item._1440Min?.ToString("0.00")</td>
                                    <td>@item._4320Min?.ToString("0.00")</td>
                                    <td>@item._10080Min?.ToString("0.00")</td>
                                }
                                else
                                {
                                    foreach (var duration in Model.SelectedDurations)
                                    {
                                        <td>

                                            @{
                                                var value = duration switch
                                                {
                                                    "5" => item._5Min,
                                                    "10" => item._10Min,
                                                    "15" => item._15Min,
                                                    "30" => item._30Min,
                                                    "60" => item._60Min,
                                                    "120" => item._120Min,
                                                    "1440" => item._1440Min,
                                                    "4320" => item._4320Min,
                                                    "10080" => item._10080Min,
                                                    _ => null
                                                };
                                            }

                                            @value?.ToString("0.00")

                                        </td>
                                    }
                                }
                                <td>
                                    @item.SourceSheet
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }

    <!-- SUMMARY -->
    @if (Model.Results != null && Model.Results.Any())
    {
        <section class="results-card">
            <div class="results-header">
                <div>
                    <h2>
                        @(string.IsNullOrEmpty(Model.PolygonGeoJson) ? "Point Summary Statistics" : "Area Summary Statistics")
                    </h2>
                    <p>
                        Minimum, maximum and average rainfall values.
                    </p>
                </div>
            </div>
            <div class="table-scroll">
                <table class="modern-table summary-table">
                    <thead>
                        @if (!Model.SelectedDurations.Any())
                        {
                            <tr>
                                <th rowspan="2">
                                    Return Period
                                </th>
                                <th colspan="3">5 Min</th>
                                <th colspan="3">10 Min</th>
                                <th colspan="3">15 Min</th>
                                <th colspan="3">30 Min</th>
                                <th colspan="3">1 Hour</th>
                                <th colspan="3">2 Hours</th>
                                <th colspan="3">1 Day</th>
                                <th colspan="3">3 Days</th>
                                <th colspan="3">7 Days</th>
                            </tr>
                            <tr>
                                @for (int i = 0; i < 9; i++)
                                {
                                    <th>Min</th>
                                    <th>Max</th>
                                    <th>Avg</th>
                                }
                            </tr>
                        }
                        else
                        {
                            <tr>
                                <th>
                                    Return Period
                                </th>
                                @foreach (var duration in Model.SelectedDurations)
                                {
                                    <th>
                                        Min @duration
                                    </th>
                                    <th>
                                        Max @duration
                                    </th>
                                    <th>
                                        Avg @duration
                                    </th>
                                }
                            </tr>
                        }
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Summary)
                        {
                            <tr>
                                <td>
                                    <span class="return-period-badge">
                                        @item.ReturnPeriod
                                    </span>
                                </td>
                                @if (!Model.SelectedDurations.Any())
                                {
                                    <td>@item.Min5?.ToString("0.00")</td>
                                    <td>@item.Max5?.ToString("0.00")</td>
                                    <td class="average-value">@item.Avg5?.ToString("0.00")</td>

                                    <td>@item.Min10?.ToString("0.00")</td>
                                    <td>@item.Max10?.ToString("0.00")</td>
                                    <td class="average-value">@item.Avg10?.ToString("0.00")</td>

                                    <td>@item.Min15?.ToString("0.00")</td>
                                    <td>@item.Max15?.ToString("0.00")</td>
                                    <td class="average-value">@item.Avg15?.ToString("0.00")</td>

                                    <td>@item.Min30?.ToString("0.00")</td>
                                    <td>@item.Max30?.ToString("0.00")</td>
                                    <td class="average-value">@item.Avg30?.ToString("0.00")</td>

                                    <td>@item.Min60?.ToString("0.00")</td>
                                    <td>@item.Max60?.ToString("0.00")</td>
                                    <td class="average-value">@item.Avg60?.ToString("0.00")</td>

                                    <td>@item.Min120?.ToString("0.00")</td>
                                    <td>@item.Max120?.ToString("0.00")</td>
                                    <td class="average-value">@item.Avg120?.ToString("0.00")</td>

                                    <td>@item.Min1440?.ToString("0.00")</td>
                                    <td>@item.Max1440?.ToString("0.00")</td>
                                    <td class="average-value">@item.Avg1440?.ToString("0.00")</td>

                                    <td>@item.Min4320?.ToString("0.00")</td>
                                    <td>@item.Max4320?.ToString("0.00")</td>
                                    <td class="average-value">@item.Avg4320?.ToString("0.00")</td>

                                    <td>@item.Min10080?.ToString("0.00")</td>
                                    <td>@item.Max10080?.ToString("0.00")</td>
                                    <td class="average-value">@item.Avg10080?.ToString("0.00")</td>
                                }
                                else
                                {
                                    @foreach (var duration in Model.SelectedDurations)
                                    {
                                        double? min = duration switch
                                        {
                                            "5" => item.Min5,
                                            "10" => item.Min10,
                                            "15" => item.Min15,
                                            "30" => item.Min30,
                                            "60" => item.Min60,
                                            "120" => item.Min120,
                                            "1440" => item.Min1440,
                                            "4320" => item.Min4320,
                                            "10080" => item.Min10080,
                                            _ => null
                                        };

                                        double? max = duration switch
                                        {
                                            "5" => item.Max5,
                                            "10" => item.Max10,
                                            "15" => item.Max15,
                                            "30" => item.Max30,
                                            "60" => item.Max60,
                                            "120" => item.Max120,
                                            "1440" => item.Max1440,
                                            "4320" => item.Max4320,
                                            "10080" => item.Max10080,
                                            _ => null
                                        };

                                        double? avg = duration switch
                                        {
                                            "5" => item.Avg5,
                                            "10" => item.Avg10,
                                            "15" => item.Avg15,
                                            "30" => item.Avg30,
                                            "60" => item.Avg60,
                                            "120" => item.Avg120,
                                            "1440" => item.Avg1440,
                                            "4320" => item.Avg4320,
                                            "10080" => item.Avg10080,
                                            _ => null
                                        };

                                        <td>@min?.ToString("0.00")</td>

                                        <td>@max?.ToString("0.00")</td>

                                        <td class="average-value">
                                            @avg?.ToString("0.00")
                                        </td>
                                    }
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
</div>

<!-- PCSWMM EXPORT MODAL -->
<div class="modal fade" id="exportModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modern-modal">
            <div class="modal-header">
                <div>
                    <h5 class="modal-title">
                        ⚡ Export to PCSWMM
                    </h5>
                    <small>
                        Configure your PCSWMM storm export.
                    </small>
                </div>
            </div>
            <div class="modal-body">
                <label for="stormType"class="modern-label">
                    South African SCS Type
                </label>
                <select id="stormType" class="modern-input">
                    <option value="Type_1">
                        South Africa SCS Type 1
                    </option>
                    <option value="Type_2">
                        South Africa SCS Type 2
                    </option>
                    <option value="Both">
                        Both
                    </option>
                </select>
                <div class="modal-field">
                    <label for="modelFolderPath" class="modern-label">
                        PCSWMM Model Directory
                    </label>
                    <input type="text" id="modelFolderPath" class="modern-input" placeholder="C:\Users\YourName\Documents\YourModel" autocomplete="off" />
                    <small>
                        Copy the address from the Windows Explorer address bar
                        and paste it here.
                    </small>
                </div>
                <div class="modern-info">
                    <strong>ℹ Export Information</strong>
                    <p>
                        The generated PCSWMM files will be packaged into:
                    </p>
                    <strong>
                        Generated_SWMM_Storms.zip
                    </strong>
                    <p>
                        The ZIP contains the generated
                        <strong>.dat</strong> files,
                        <strong>SWMM_Raingages_List.txt</strong>
                        and
                        <strong>SWMM_Timeseries_List.txt</strong>.
                    </p>
                </div>
            </div>
            <div class="modal-footer">
               <button class="modal-button secondary" data-bs-dismiss="modal">
                    Cancel
                </button>
                <button class="modal-button primary" id="btnGenerate">
                    ⚡ Generate Files
                </button>
            </div>
        </div>
    </div>
</div>

<!-- PROGRESS MODAL -->
<div class="modal fade" id="progressModal" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modern-modal">
            <div class="modal-header">
                <h5>
                    ⚡ Generating PCSWMM Files
                </h5>
            </div>
            <div class="modal-body">
                <p id="progressText">
                    Preparing export...
                </p>
                <div class="modern-progress">
                    <div id="progressBar">
                        0%
                    </div>
                </div>
                <div class="progress-details">
                    <div>
                        <span>Total Files</span>
                        <strong id="totalFiles">0</strong>
                    </div>
                    <div>
                        <span>Completed</span>
                        <strong id="completedFiles">0</strong>
                    </div>
                    <div>
                        <span>Current File</span>
                        <strong id="currentFile">
                            Preparing...
                        </strong>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- COMPLETE MODAL -->
<div class="modal fade" id="completeModal">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modern-modal">
            <div class="modal-header">
                <h5>
                    ✅ Export Complete
                </h5>
            </div>
            <div class="modal-body">
                <div class="success-message">
                    <strong>
                        ✔ Export completed successfully.
                    </strong>
                    <br />
                    <span>
                        <strong id="fileCount"></strong>
                        PCSWMM files were generated.
                    </span>
                </div>
                <p>
                    Click <strong>Download ZIP Files</strong> and save the ZIP
                    file inside your <strong>PCSWMM Model</strong> folder.
                </p>
                <div class="zip-name">
                    Generated_SWMM_Storms.zip
                </div>
                <button class="modal-button success full-width" id="btnDownloadZip">
                    ⬇ Download ZIP Files
                </button>
            </div>
            <div class="modal-footer">
                <button class="modal-button primary" id="btnContinue" disabled>
                    Continue to Instructions →
                </button>
            </div>
        </div>
    </div>
</div>

<!-- JAVASCRIPT -->
<script>
    window.addEventListener("load", function() {
        //MAP

        var durbanCenter = [-29.8587, 31.0218];
        var map = L.map("map").setView(durbanCenter, 12);
        var southWest = L.latLng(-30.2, 30.6);
        var northEast = L.latLng(-29.5, 31.5);
        var durbanBounds =
            L.latLngBounds(southWest, northEast);

        map.setMaxBounds(durbanBounds);

        map.on("drag", function() {
            map.panInsideBounds(
                durbanBounds,
                {
                    animate: false
                }
            );
        });

        L.tileLayer(
            "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
            {
                attribution:
                    "&copy; OpenStreetMap contributors"
            }
        ).addTo(map);

        //DRAWING 
        var drawnItems =
            new L.FeatureGroup();
        map.addLayer(drawnItems);
        var uploadedLayer = null;
        var marker = null;

        function placeMarker(lat, lng) {
            if (marker) {
                map.removeLayer(marker);
            }

            marker =
                L.marker([lat, lng])
                    .addTo(map);

            map.setView(
                [lat, lng],
                14
            );
        }

        function clearPolygon() {
            drawnItems.clearLayers();

            if (uploadedLayer) {
                map.removeLayer(
                    uploadedLayer
                );
                uploadedLayer = null;
            }

            document.getElementById(
                "PolygonGeoJson"
            ).value = "";
        }

        // UPLOAD AREA 

        document
            .getElementById("uploadAreaBtn")
            .addEventListener(
                "click",
                async function() {
                    var fileInput =
                        document.getElementById(
                            "areaFileInput"
                        );

                    if (
                        !fileInput.files ||
                        fileInput.files.length === 0
                    ) {
                        alert(
                            "Please select a file first."
                        );
                        return;
                    }

                    var file =
                        fileInput.files[0];

                    var formData =
                        new FormData();

                    formData.append(
                        "file",
                        file
                    );

                    try {
                        const response =
                            await fetch(
                                "/Rainfall/UploadAreaFile",
                                {
                                    method: "POST",
                                    body: formData
                                }
                            );

                        if (!response.ok) {
                            alert(
                                "File upload failed."
                            );
                            return;
                        }

                        const geojsonText =
                            await response.text();

                        const geojson =
                            JSON.parse(
                                geojsonText
                            );

                        if (uploadedLayer) {
                            map.removeLayer(
                                uploadedLayer
                            );
                        }

                        uploadedLayer =
                            L.geoJSON(
                                geojson,
                                {
                                    style: {
                                        color: "#007bff",
                                        weight: 3,
                                        fillOpacity: 0.15
                                    }
                                }
                            ).addTo(map);

                        drawnItems.clearLayers();

                        uploadedLayer.eachLayer(
                            function(layer) {
                                drawnItems.addLayer(
                                    layer
                                );
                            }
                        );

                        map.fitBounds(
                            uploadedLayer.getBounds()
                        );

                        document.getElementById(
                            "PolygonGeoJson"
                        ).value =
                            JSON.stringify(
                                geojson
                            );

                        var coords =
                            extractCoords(
                                geojson
                            );

                        var lats =
                            coords.map(
                                c => c[1]
                            );

                        var lons =
                            coords.map(
                                c => c[0]
                            );

                        var avgLat =
                            lats.reduce(
                                (a, b) => a + b,
                                0
                            ) / lats.length;


                        var avgLon =
                            lons.reduce(
                                (a, b) => a + b,
                                0
                            ) / lons.length;

                        if (
                            !isNaN(avgLat) &&
                            !isNaN(avgLon)
                        ) {
                            updateInputsFromCoordinates(
                                avgLat,
                                avgLon
                            );
                        }

                        alert(
                            "Polygon loaded successfully. Now click Search."
                        );
                    }
                    catch (err) {
                        console.error(err);
                        alert(
                            "Error processing file: " +
                            err.message
                        );
                    }
                }
            );

        function extractCoords(geojson) {
            if (
                geojson.type ===
                "FeatureCollection"
            ) {
                return geojson.features[0]
                    .geometry.coordinates[0];
            }

            if (
                geojson.type ===
                "Feature"
            ) {
                return geojson.geometry
                    .coordinates[0];
            }

            if (
                geojson.type ===
                "Polygon"
            ) {
                return geojson.coordinates[0];
            }

            if (
                geojson.type ===
                "MultiPolygon"
            ) {
                return geojson.coordinates[0][0];
            }

            throw new Error(
                "Unsupported GeoJSON format"
            );
        }

        // COORDINATES
        function degMinToDecimal(
            deg,
            min
        ) {
            if (
                deg === null ||
                deg === "" ||
                isNaN(deg)
            ) {
                return null;
            }
            return (
                parseFloat(deg) +
                (parseFloat(min) || 0) / 60
            );
        }

        function decimalToDegMin(value) {
            var abs =
                Math.abs(value);

            var deg =
                Math.floor(abs);

            var min =
                Math.round(
                    (abs - deg) * 60
                );

            if (min === 60) {
                deg += 1;
                min = 0;
            }

            return {
                deg: deg,
                min: min
            };
        }

        function updateInputsFromCoordinates(
            lat,
            lng
        ) {
            var latParts =
                decimalToDegMin(lat);

            var lngParts =
                decimalToDegMin(lng);

            document.getElementById(
                "LATDEG"
            ).value =
                latParts.deg;

            document.getElementById(
                "LATMIN"
            ).value =
                latParts.min;

            document.getElementById(
                "LONGDEG"
            ).value =
                lngParts.deg;

            document.getElementById(
                "LONGMIN"
            ).value =
                lngParts.min;
        }

        function updateMarkerFromInputs() {
            var latDeg =
                parseFloat(
                    document.getElementById(
                        "LATDEG"
                    ).value
                );

            var latMin =
                parseFloat(
                    document.getElementById(
                        "LATMIN"
                    ).value
                );

            var lngDeg =
                parseFloat(
                    document.getElementById(
                        "LONGDEG"
                    ).value
                );

            var lngMin =
                parseFloat(
                    document.getElementById(
                        "LONGMIN"
                    ).value
                );

            if (
                !isNaN(latDeg) &&
                !isNaN(lngDeg)
            ) {
                var lat =
                    -degMinToDecimal(
                        latDeg,
                        latMin
                    );

                var lng =
                    degMinToDecimal(
                        lngDeg,
                        lngMin
                    );

                placeMarker(
                    lat,
                    lng
                );
            }
        }

        // MAP CLICK 
        map.on(
            "click",
            function(e) {
                clearPolygon();

                placeMarker(
                    e.latlng.lat,
                    e.latlng.lng
                );

                updateInputsFromCoordinates(
                    e.latlng.lat,
                    e.latlng.lng
                );
            }
        );

        // ADDRESS
        function showMessage(
            msg,
            isError = true
        ) {
            var box =
                document.getElementById(
                    "addressMessage"
                );

            if (!box) return;

            box.style.color =
                isError
                    ? "#dc3545"
                    : "#198754";

            box.innerText =
                msg;
        }

        var btn =
            document.getElementById(
                "searchAddressBtn"
            );

        if (btn) {
            btn.addEventListener(
                "click",
                async function(e) {
                    e.preventDefault();

                    showMessage("");

                    var address =
                        document.getElementById(
                            "Address"
                        ).value;

                    if (
                        !address ||
                        address.trim() === ""
                    ) {
                        showMessage(
                            "Please enter an address."
                        );
                        return;
                    }
                    try {
                        const apiKey = "AIzaSyC688eU0nYXp4K6Qx_HV3dj4dLLaWJPBNM";

                        var url =
                            "https://maps.googleapis.com/maps/api/geocode/json?address=" +
                            encodeURIComponent(address) +
                            "&key=" +
                            apiKey;

                        var response =
                            await fetch(url);

                        var data =
                            await response.json();

                        if (
                            !data.results ||
                            data.results.length === 0
                        ) {
                            showMessage(
                                "Address not found."
                            );
                            return;
                        }

                        var location =
                            data.results[0]
                                .geometry.location;

                        clearPolygon();

                        placeMarker(
                            location.lat,
                            location.lng
                        );

                        updateInputsFromCoordinates(
                            location.lat,
                            location.lng
                        );

                        showMessage(
                            "Address found!",
                            false
                        );
                    }
                    catch (error) {
                        console.error(error);
                        showMessage(
                            "Error finding address."
                        );
                    }
                }
            );
        }

        // DRAW POLYGON
        var drawControl =
            new L.Control.Draw({
                draw: {
                    polygon: true,
                    rectangle: false,
                    circle: false,
                    circlemarker: false,
                    marker: false,
                    polyline: false
                },
                edit: {
                    featureGroup:
                        drawnItems
                }
            });

        map.addControl(
            drawControl
        );

        map.on(
            L.Draw.Event.CREATED,
            function(e) {
                drawnItems.clearLayers();
                drawnItems.addLayer(
                    e.layer
                );

                var geojson =
                    e.layer.toGeoJSON();

                document.getElementById(
                    "PolygonGeoJson"
                ).value =
                    JSON.stringify(
                        geojson
                    );
            }
        );

        // RESTORE SAVED POLYGON 
        var savedPolygon =
            document.getElementById(
                "PolygonGeoJson"
            ).value;

        if (savedPolygon) {
            try {
                var geo =
                    JSON.parse(
                        savedPolygon
                    );
                var layer =
                    L.geoJSON(
                        geo,
                        {
                            style: {
                                color: "#007bff",
                                weight: 3,
                                fillOpacity: 0.15
                            }
                        }
                    );

                layer.addTo(map);

                drawnItems.addLayer(
                    layer
                );

                map.fitBounds(
                    layer.getBounds()
                );
            }
            catch (e) {
                console.log(
                    "Invalid polygon JSON",
                    e
                );
            }
        }

        // GOOGLE AUTOCOMPLETE
        const addressInput =
            document.getElementById(
                "Address"
            );

        if (
            addressInput &&
            typeof google !== "undefined"
        ) {
            const autocomplete =
                new google.maps.places.Autocomplete(
                    addressInput,
                    {
                        types: ["address"],
                        componentRestrictions: {
                            country: "za"
                        },
                        strictBounds: false,
                        fields: [
                            "geometry",
                            "formatted_address",
                            "name"
                        ]
                    }
                );

            autocomplete.setBounds(
                new google.maps.LatLngBounds(
                    new google.maps.LatLng(
                        -30.2,
                        30.6
                    ),
                    new google.maps.LatLng(
                        -29.5,
                        31.5
                    )
                )
            );

            autocomplete.addListener(
                "place_changed",
                function() {
                    const place =
                        autocomplete.getPlace();

                    if (!place.geometry) {
                        showMessage(
                            "Address not found."
                        );
                        return;
                    }

                    const lat =
                        place.geometry
                            .location.lat();

                    const lng =
                        place.geometry
                            .location.lng();

                    clearPolygon();

                    placeMarker(
                        lat,
                        lng
                    );

                    updateInputsFromCoordinates(
                        lat,
                        lng
                    );

                    showMessage(
                        "Address selected!",
                        false
                    );
                }
            );
        }

        // SUBMIT
        document
            .querySelector(".rainfall-form")
            .addEventListener(
                "submit",
                function() {
                    var allLayers =
                        drawnItems.toGeoJSON();

                    if (
                        allLayers &&
                        allLayers.features &&
                        allLayers.features.length > 0
                    ) {
                        document.getElementById(
                            "PolygonGeoJson"
                        ).value =
                            JSON.stringify(
                                allLayers
                            );
                    }
                }
            );

        // PCSWMM EXPORT
        const exportResults =
            @Html.Raw(Json.Serialize(Model.Results));

        const selectedDurations =
            @Html.Raw(Json.Serialize(Model.SelectedDurations));

        let generatedZip = null;
        let downloaded = false;

        const exportModal =
            new bootstrap.Modal(
                document.getElementById(
                    "exportModal"
                )
            );

        const progressModal =
            new bootstrap.Modal(
                document.getElementById(
                    "progressModal"
                )
            );

        const completeModal =
            new bootstrap.Modal(
                document.getElementById(
                    "completeModal"
                )
            );

        document
            .getElementById(
                "btnExportPCSWMM"
            )
            .addEventListener(
                "click",
                function() {
                    exportModal.show();
                }
            );

        document
            .getElementById(
                "btnGenerate"
            )
            .addEventListener(
                "click",
                async function() {
                    const modelFolderPath =
                        document.getElementById(
                            "modelFolderPath"
                        )
                            .value
                            .trim();

                    if (!modelFolderPath) {
                        alert(
                            "Please enter your PCSWMM Model Directory."
                        );
                        return;
                    }

                    const stormType =
                        document.getElementById(
                            "stormType"
                        ).value;

                    exportModal.hide();
                    progressModal.show();

                    document.getElementById(
                        "progressBar"
                    ).style.width =
                        "0%";

                    document.getElementById(
                        "progressBar"
                    ).innerHTML =
                        "0%";

                    document.getElementById(
                        "progressText"
                    ).innerHTML =
                        "Preparing export...";

                    document.getElementById(
                        "totalFiles"
                    ).innerHTML =
                        "0";

                    document.getElementById(
                        "completedFiles"
                    ).innerHTML =
                        "0";

                    document.getElementById(
                        "currentFile"
                    ).innerHTML =
                        "Preparing...";

                    try {
                        const response =
                            await fetch(
                                "/Rainfall/GeneratePCSWMM",
                                {
                                    method: "POST",
                                    headers: {
                                        "Content-Type":
                                            "application/json"
                                    },
                                    body:
                                        JSON.stringify({
                                            stormType:
                                                stormType,
                                            results:
                                                exportResults,
                                            selectedDurations:
                                                selectedDurations,
                                            modelFolderPath:
                                                modelFolderPath
                                        })
                                }
                            );

                        if (!response.ok) {
                            const errorText =
                                await response.text();

                            progressModal.hide();

                            alert(
                                errorText ||
                                "Failed to generate PCSWMM files."
                            );
                            return;
                        }

                        const zipBlob =
                            await response.blob();

                        generatedZip =
                            URL.createObjectURL(
                                zipBlob
                            );

                        progressModal.hide();
                        completeModal.show();
                    }
                    catch (err) {
                        console.error(err);
                        progressModal.hide();
                        alert(
                            "An error occurred while generating the PCSWMM files."
                        );
                    }
                }
            );

        // DOWNLOAD ZIP
        document
            .getElementById(
                "btnDownloadZip"
            )
            .addEventListener(
                "click",
                async function() {
                    if (!generatedZip) {
                        return;
                    }

                    try {
                        const fileHandle =
                            await window.showSaveFilePicker(
                                {
                                    suggestedName:
                                        "Generated_SWMM_Storms.zip",
                                    types: [
                                        {
                                            description:
                                                "ZIP files",
                                            accept: {
                                                "application/zip":
                                                    [".zip"]
                                            }
                                        }
                                    ]
                                }
                            );

                        const response =
                            await fetch(
                                generatedZip
                            );

                        const blob =
                            await response.blob();

                        const writable =
                            await fileHandle
                                .createWritable();

                        await writable.write(
                            blob
                        );

                        await writable.close();

                        downloaded = true;
                        updateContinueButton();
                    }
                    catch (error) {
                        if (
                            error.name ===
                            "AbortError"
                        ) {
                            return;
                        }
                        console.error(
                            "Error saving ZIP:",
                            error
                        );
                    }
                }
            );

        function updateContinueButton() {
            document.getElementById(
                "btnContinue"
            ).disabled =
                !downloaded;
        }

        // CONTINUE
        document
            .getElementById(
                "btnContinue"
            )
            .addEventListener(
                "click",
                function() {
                    window.location =
                        "/Rainfall/Instructions";
                }
            );

        // PROGRESS
        function updateProgress(progress) {
            document.getElementById(
                "progressBar"
            ).style.width =
                progress.percentage +
                "%";

            document.getElementById(
                "progressBar"
            ).innerHTML =
                progress.percentage +
                "%";

            document.getElementById(
                "totalFiles"
            ).innerHTML =
                progress.totalFiles;

            document.getElementById(
                "completedFiles"
            ).innerHTML =
                progress.filesCompleted;

            document.getElementById(
                "currentFile"
            ).innerHTML =
                progress.currentFile;

            document.getElementById(
                "progressText"
            ).innerHTML =
                "<strong>Generating:</strong><br>" +
                progress.currentFile +
                "<br><br>" +
                progress.filesCompleted +
                " of " +
                progress.totalFiles +
                " files completed.";
        }
    });
</script>
