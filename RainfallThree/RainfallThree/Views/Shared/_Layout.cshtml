<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EDRE</title>
    <link rel="icon" type="image/png" href="~/images/EDREIcon.png" />
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RainfallThree.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg custom-navbar border-bottom box-shadow mb-3">
            <div class="container-fluid px-3">
                <a class="navbar-brand app-title me-2">EDRE</a>
                <a class="navbar-brand d-flex align-items-center gap-1">
                    <img src="/images/ethekwini_logo.png" alt="eThekwini Logo" style="height:35px;" />
                    <img src="/images/cscm_logo.png" alt="CSCM Logo" style="height:35px;" />
                </a>
                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavContent"
                        aria-controls="mainNavContent"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Rainfall" asp-action="Search">Design Rainfall Data</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Storm" asp-action="Index">Storm Events</a>
                            </li>
                        }
                        @if (User.IsInRole("PrimaryUser"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Admin" asp-action="PendingUsers">User Approvals</a>
                            </li>
                        }
                    </ul>
                    <div class="nav-login-partial">
                        <partial name="_LoginPartial" />
                    </div>
                </div>

            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer border-top py-3">
        <div class="container">
            <p class="footer-text mb-0">
                &copy; 2026 E.D.R.E. All rights reserved.
                <span class="footer-sep">&nbsp;|&nbsp;</span>
                Commissioned by CSCM: Engineering Data Management.
                <span class="footer-sep">&nbsp;|&nbsp;</span>
                All intellectual property rights in this application, including its content, design, and functionality, are reserved.
                <span class="footer-sep">&nbsp;|&nbsp;</span>
                V 1.1.1
            </p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
